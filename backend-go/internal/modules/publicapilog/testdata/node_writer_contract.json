{
  "version": 1,
  "runtimeOwner": "node",
  "goProductionTakeover": false,
  "queue": {
    "nodeLocalMaxItems": 5000,
    "nodeLocalMaxBytes": 33554432,
    "nodeFlushBatchSize": 50,
    "nodeShutdownMaxBatches": 100,
    "goTaskType": "public-api-log:write",
    "goQueueName": "public-api-logs",
    "goPayloadVersion": 1,
    "goTaskTimeoutSeconds": 30,
    "goTaskRetentionHours": 24,
    "goMaxRetry": 10,
    "nodePostgresRowsPerInsert": 1000,
    "stableIdBeforeDispatch": true,
    "idempotentConflict": "do_nothing",
    "redisFailureFallback": "none"
  },
  "payload": {
    "maxBytesPerSide": 32768,
    "maxDepth": 8,
    "maxEntries": 200,
    "stringPreviewBytes": 4096,
    "captureStatuses": ["complete", "truncated", "empty", "dropped"],
    "capturedHeaders": ["contentType", "contentLength"],
    "preserveRawValues": true
  },
  "retention": {
    "setting": "publicApiLogRetentionDays",
    "defaultDays": 30,
    "minDays": 1,
    "maxDays": 365,
    "batchRows": 1000,
    "maxBatchesPerRun": 20
  },
  "reader": {
    "maxVisibleRows": 1000,
    "maxPageSize": 100,
    "stableOrder": ["created_at DESC", "id DESC"],
    "summaryExcludes": ["request_data_json", "response_data_json"],
    "detailIncludes": ["request_data_json", "response_data_json"]
  }
}
