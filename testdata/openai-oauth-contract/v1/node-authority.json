{
  "version": 1,
  "authority": "node",
  "transport": {
    "mode": "manual_callback_url_submission",
    "mounts": [
      {
        "prefix": "/__aisys__/api/my-openai-oauth",
        "scope": "authenticated_self"
      },
      {
        "prefix": "/__aisys__/api/openai-oauth",
        "scope": "admin"
      }
    ],
    "routerEndpoints": [
      {
        "method": "POST",
        "path": "/auth-url",
        "successStatus": 200
      },
      {
        "method": "POST",
        "path": "/create-from-code",
        "successStatus": 201,
        "mutationGuardOperationKey": "openai_oauth.create_from_code"
      },
      {
        "method": "POST",
        "path": "/create-from-refresh-token",
        "successStatus": 201,
        "mutationGuardOperationKey": "openai_oauth.create_from_refresh_token"
      },
      {
        "method": "POST",
        "path": "/accounts/:id/refresh-token",
        "successStatus": 200
      },
      {
        "method": "POST",
        "path": "/accounts/:id/reauthorize-from-code",
        "successStatus": 200
      },
      {
        "method": "POST",
        "path": "/accounts/:id/reauthorize-from-refresh-token",
        "successStatus": 200
      }
    ],
    "absentDedicatedEndpoints": [
      "/callback",
      "/poll",
      "/cancel"
    ]
  },
  "authorization": {
    "authorizeUrl": "https://auth.openai.com/oauth/authorize",
    "tokenUrl": "https://auth.openai.com/oauth/token",
    "clientId": "app_EMoamEEZ73f0CkXaXp7hrann",
    "redirectUri": "http://localhost:1455/auth/callback",
    "scopes": "openid profile email offline_access api.connectors.read api.connectors.invoke",
    "query": {
      "response_type": "code",
      "code_challenge_method": "S256",
      "id_token_add_organizations": "true",
      "codex_cli_simplified_flow": "true",
      "originator": "codex_cli_rs"
    }
  },
  "session": {
    "ttlSeconds": 1800,
    "globalMaxEntries": 1024,
    "ownerMaxEntries": 8,
    "stateBytes": 32,
    "codeVerifierBytes": 64,
    "sessionIdBytes": 16,
    "consume": "atomic_compare_delete_once",
    "ownerBound": true
  },
  "tokenExchange": {
    "authorizationCodeContentType": "application/x-www-form-urlencoded",
    "refreshTokenContentType": "application/json",
    "refreshHeaders": {
      "originator": "codex_cli_rs",
      "user-agent": "codex_cli_rs/0.144.4"
    },
    "timeoutMs": 25000,
    "responseMaxBytes": 262144,
    "expiresIn": "finite_positive_integer_seconds",
    "refreshLeadSeconds": 60
  },
  "idempotency": {
    "authUrl": "new_session_per_request",
    "codeSession": "atomic_compare_delete_once",
    "guardedOperations": [
      {
        "operationKey": "openai_oauth.create_from_code",
        "processingTtlMs": 180000
      },
      {
        "operationKey": "openai_oauth.create_from_refresh_token",
        "processingTtlMs": 180000
      }
    ],
    "unguardedOperations": [
      "openai_oauth.refresh_token",
      "openai_oauth.reauthorize_from_code",
      "openai_oauth.reauthorize_from_refresh_token"
    ]
  },
  "persistence": {
    "createOrder": [
      "validate_request_and_scope",
      "validate_provider_group_and_policies",
      "exchange_or_refresh_token",
      "create_account_and_operation_log",
      "dispatch_pending_health_check",
      "return_sanitized_account"
    ],
    "createdAccount": {
      "providerCode": "gpt",
      "type": "oauth",
      "status": "pending_test",
      "schedulable": false
    },
    "credentialKeys": [
      "access_token",
      "refresh_token",
      "id_token",
      "expires_at",
      "client_id",
      "email",
      "account_id",
      "chatgpt_user_id",
      "plan_type",
      "base_url"
    ],
    "response": "sanitized_account_envelope",
    "reauthorize": [
      "preserve_existing_non_token_credentials",
      "overwrite_server_token_fields",
      "update_credentials_only",
      "clear_only_refresh_failure_state"
    ]
  },
  "errorStatusScope": "explicit_route_handler_branches_only_excludes_middleware_and_uncaught_async_errors",
  "errors": [
    {
      "operation": "auth_url",
      "statuses": [200, 400, 500]
    },
    {
      "operation": "create_from_code",
      "statuses": [201, 400, 409, 502]
    },
    {
      "operation": "create_from_refresh_token",
      "statuses": [201, 400, 409, 502]
    },
    {
      "operation": "refresh_token",
      "statuses": [200, 400, 404, 502]
    },
    {
      "operation": "reauthorize_from_code",
      "statuses": [200, 400, 404, 409, 502]
    },
    {
      "operation": "reauthorize_from_refresh_token",
      "statuses": [200, 400, 404, 409, 502]
    }
  ],
  "knownNodeDefects": [
    {
      "id": "session-consumed-before-token-success",
      "currentBehavior": "授权码交换在发起 token HTTP 请求前就 compare-delete 消费 session；网络失败或上游 5xx 后不能用同一回调重试，只能重新发起授权。",
      "goMigration": "Go 保留 state 一次性与 owner 绑定，但把 session 设为有租约的 processing 状态；只有成功落库或明确终态授权错误才删除，网络失败可在短租约内安全重试。",
      "disposition": "fix_in_go_do_not_copy"
    },
    {
      "id": "no-stable-machine-error-code",
      "currentBehavior": "OAuth 路由错误主要返回中文 message 和 HTTP 状态，未提供稳定的机器可读 error code；前端只能按状态或文案处理。",
      "goMigration": "Go 新契约增加稳定 error.code 与安全 message，同时保持 HTTP 状态与敏感信息脱敏；不要把中文文案当作协议键。",
      "disposition": "fix_in_go_do_not_copy"
    },
    {
      "id": "reauthorize-refresh-token-without-idempotency-or-cas",
      "currentBehavior": "Refresh Token 重新授权路由没有 mutation guard，token exchange 后通过普通 updateAccountAsync 覆盖凭据且不校验 config revision；它可与后台保活、手动刷新或重复提交并发，旧请求可能覆盖较新的轮换 token。",
      "goMigration": "Go 对同一账户使用稳定幂等指纹和单账户 lease，并以 ExpectedConfigRevision CAS 写入；冲突时只接受数据库中的更新 token，或按最新 refresh token 最多重试一次，绝不无条件覆盖。",
      "disposition": "fix_in_go_do_not_copy"
    }
  ]
}
