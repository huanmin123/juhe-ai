    }
  },
  "routes": [
    {
      "id": "get-image-policy",
      "method": "GET",
      "path": "/image-policy",
      "frontend": "chatApi.getImagePolicy",
      "auth": "session",
      "owner": { "scope": "authenticated-user-policy", "source": "requireChatAuth" },
      "request": { "path": {}, "query": {}, "body": { "kind": "none", "fields": [] } },
      "cursor": null,
      "success": [{ "status": 200, "envelope": "json-data", "dto": "ChatImagePolicy", "fixture": { "data": { "input": { "mimeType": "image/webp", "maxEdge": 1024, "quality": 82, "maxBytes": 1048576 } } } }],
      "errors": []
    },
    {
      "id": "list-conversations",
      "method": "GET",
      "path": "/conversations",
      "frontend": "chatApi.listConversations",
      "auth": "session",
