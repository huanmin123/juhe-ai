{
  "contract": "ai-chat-http",
  "version": 1,
  "basePath": "/__aisys__/api/my-chat",
  "frontendBasePath": "/my-chat",
  "authority": {
    "authentication": "session cookie via requireAuth",
    "authorization": "forceSelfAccessScope rewrites the request role to user and removes query.systemAccountId",
    "ownerKey": "systemAccountId from request auth context",
    "foreignResources": "must not be returned across owners; current per-route status/code is frozen below"
  },
  "normalization": {
    "rule": "Only opaque identifiers and RFC3339 timestamps are replaced. Field names, enum values, status codes, error codes, numbers, booleans and envelopes are never normalized.",
    "tokens": {
      "<system-account-id>": { "kind": "id", "meaning": "authenticated system account ID" },
      "<api-key-id>": { "kind": "id", "meaning": "API Key ID" },
      "<conversation-id>": { "kind": "id", "meaning": "chat conversation ID" },
      "<message-id>": { "kind": "id", "meaning": "chat message ID" },
      "<assistant-message-id>": { "kind": "id", "meaning": "assistant message ID" },
      "<turn-id>": { "kind": "id", "meaning": "chat turn ID" },
      "<client-message-id>": { "kind": "id", "meaning": "client idempotency message ID" },
      "<asset-id>": { "kind": "id", "meaning": "chat asset ID" },
      "<trace-id>": { "kind": "id", "meaning": "request trace ID" },
      "<tool-id>": { "kind": "id", "meaning": "tool event ID" },
      "<block-id>": { "kind": "id", "meaning": "content block ID" },
      "<timestamp>": { "kind": "time", "format": "RFC3339/ISO-8601 timestamp" }
    }
  },
  "envelopes": {
    "json-data": { "required": ["data"], "optional": ["message"], "additionalProperties": false },
    "json-error": { "required": ["message"], "optional": ["code"], "additionalProperties": false },
    "json-timed-error": { "required": ["message", "code", "serverTime"], "optional": [], "additionalProperties": false },
    "empty": { "body": "none" },
    "binary": { "body": "raw bytes; no JSON envelope" },
    "sse": { "body": "text/event-stream; SSE event contract is frozen separately" }
  },
  "enums": {
    "ChatMessageRole": ["user", "assistant"],
    "ChatMessageStatus": ["completed", "streaming", "failed", "canceled"],
    "ChatImageModel": ["gpt-image-2"],
    "ChatProcessStatus": ["started", "completed", "failed", "canceled"],
    "ChatToolStatus": ["started", "updated", "completed", "failed", "canceled"],
    "ChatContextState": ["ready", "compact_pending", "compacting", "compact_failed"],
    "ChatSubmissionState": ["preparing", "not_found", "accepted"],
    "ChatPreparationPhase": ["preparing", "accepting"],
    "ChatRunnerState": ["running", "missing", "terminal"],
    "ChatReasoningEffort": ["minimal", "low", "medium", "high", "xhigh", "max"],
    "ChatServiceTier": ["default", "priority", "flex"],
    "ChatGenerationParameter": ["temperature", "topP", "frequencyPenalty", "presencePenalty", "maxOutputTokens", "seed"],
    "ChatAssetMimeType": ["image/jpeg", "image/png", "image/webp"],
    "ChatImageInputMimeType": ["image/webp"]
  },
  "dtos": {
    "ChatImageOptimizationPolicy": {
      "required": { "mimeType": "enum:ChatImageInputMimeType", "maxEdge": "integer", "quality": "integer", "maxBytes": "integer" },
      "optional": {},
      "additionalProperties": false
    },
    "ChatImagePolicy": {
      "required": { "input": "dto:ChatImageOptimizationPolicy" },
      "optional": {},
      "additionalProperties": false
    },
    "ChatModelListOption": {
      "required": { "id": "string", "name": "string" },
      "optional": {},
      "additionalProperties": false
    },
    "ChatModelCapabilities": {
      "required": {
        "id": "string",
        "name": "string",
        "supportsPromptCaching": "boolean",
        "supportedReasoningEfforts": "array-enum:ChatReasoningEffort",
        "supportedServiceTiers": "array-enum:ChatServiceTier",
        "supportedApiProtocols": "array:string",
        "inputModalities": "array:string",
        "outputModalities": "array:string",
        "supportedTools": "array:string",
        "generationParameters": "array-dto:ChatGenerationParameterCapability"
      },
      "optional": {
        "defaultReasoningEffort": "enum:ChatReasoningEffort",
        "contextWindowTokens": "integer",
        "maxInputTokens": "integer",
        "maxOutputTokens": "integer"
      },
      "additionalProperties": false
    },
    "ChatGenerationParameterCapability": {
      "required": {
        "parameter": "enum:ChatGenerationParameter",
        "min": "number",
        "max": "number",
        "step": "number",
        "defaultValue": "number"
      },
      "optional": {},
      "additionalProperties": false
    },
    "ChatGenerationParameters": {
      "required": {},
      "optional": {
        "temperature": "number",
        "topP": "number",
        "frequencyPenalty": "number",
        "presencePenalty": "number",
        "maxOutputTokens": "integer",
        "seed": "integer"
      },
      "additionalProperties": false
    },
    "ChatConversation": {
      "required": {
        "id": "id",
        "systemAccountId": "id",
        "apiKeyNameSnapshot": "string",
        "title": "string",
        "isPinned": "boolean",
        "defaultImageModel": "enum:ChatImageModel",
        "userTurnCount": "integer",
        "messageRevision": "integer",
        "userTurnLimit": "integer",
        "lastMessageAt": "timestamp",
        "createdAt": "timestamp",
        "updatedAt": "timestamp"
      },
      "optional": {
        "apiKeyId": "id",
        "defaultModel": "dto:ChatModelListOption",
        "lastModel": "string",
        "toolCapabilities": "object",
        "activeTurnId": "id"
      },
      "additionalProperties": false
    },
    "ChatMessageContentBlock": {
      "discriminator": "type",
      "variants": {
        "output_text": { "required": { "type": "literal:output_text", "order": "integer", "text": "string" }, "optional": { "blockId": "id" } },
        "reasoning": { "required": { "type": "literal:reasoning", "text": "string" }, "optional": { "blockId": "id", "order": "integer", "status": "enum:ChatProcessStatus" } },
        "tool_call": { "required": { "type": "literal:tool_call", "toolType": "string", "status": "enum:ChatToolStatus" }, "optional": { "blockId": "id", "order": "integer", "id": "id", "callId": "id", "item": "object" } },
        "output_image": { "required": { "type": "literal:output_image", "blockId": "id", "order": "integer", "assetId": "id", "status": "enum:ChatProcessStatus" }, "optional": { "mimeType": "string", "width": "integer", "height": "integer", "revisedPrompt": "string" } },
        "input_text": { "required": { "type": "literal:input_text", "text": "string", "order": "integer" }, "optional": {} },
        "input_image": { "required": { "type": "literal:input_image", "assetId": "id", "order": "integer" }, "optional": {} }
      },
      "additionalProperties": false
    },
    "ChatToolEvent": {
      "required": { "id": "id", "type": "string", "status": "enum:ChatToolStatus" },
      "optional": { "item": "object" },
      "additionalProperties": false
    },
    "ChatMessage": {
      "required": {
        "id": "id",
        "conversationId": "id",
        "turnId": "id",
        "sequenceNo": "integer",
        "role": "enum:ChatMessageRole",
        "status": "enum:ChatMessageStatus",
        "contentText": "string",
        "contentBlocks": "array-dto:ChatMessageContentBlock",
        "model": "string",
        "createdAt": "timestamp",
        "expiresAt": "timestamp"
      },
      "optional": {
        "clientMessageId": "id",
        "traceId": "id",
        "finishReason": "string",
        "errorCode": "string",
        "errorMessage": "string",
        "completedAt": "timestamp",
        "reasoningText": "string",
        "toolEvents": "array-dto:ChatToolEvent",
        "eventVersion": "integer",
        "renderRevision": "integer"
      },
      "additionalProperties": false
    },
    "ChatAsset": {
      "required": { "id": "id", "fileName": "string", "mimeType": "enum:ChatAssetMimeType", "width": "integer", "height": "integer", "byteSize": "integer" },
      "optional": {},
      "additionalProperties": false
    },
    "ChatContextStatus": {
      "required": { "usedTokens": "integer", "ratio": "number", "state": "enum:ChatContextState", "usageEstimated": "boolean", "compactedThroughSequence": "integer", "revision": "integer", "attemptCount": "integer" },
      "optional": { "limitTokens": "integer", "errorCode": "string", "retryAt": "timestamp" },
      "additionalProperties": false
    },
    "ChatMessageTail": {
      "required": { "id": "id", "turnId": "id", "sequenceNo": "integer", "role": "enum:ChatMessageRole", "status": "enum:ChatMessageStatus", "expiresAt": "timestamp" },
      "optional": { "completedAt": "timestamp" },
      "additionalProperties": false
    },
    "ChatConversationActiveTurn": {
      "required": { "turnId": "id", "assistantMessageId": "id", "startedAt": "timestamp" },
      "optional": {},
      "additionalProperties": false
    },
    "ChatConversationSyncHead": {
      "required": { "serverTime": "timestamp", "unchanged": "boolean", "conversationId": "id", "messageRevision": "integer", "lastSequenceNo": "integer", "tail": "array-dto:ChatMessageTail" },
      "optional": { "activeTurn": "dto:ChatConversationActiveTurn" },
      "additionalProperties": false
    },
    "ChatSubmissionPreparing": {
      "required": { "state": "literal:preparing", "phase": "enum:ChatPreparationPhase", "serverTime": "timestamp" },
      "optional": {},
      "additionalProperties": false
    },
    "ChatSubmissionNotFound": {
      "required": { "state": "literal:not_found", "serverTime": "timestamp" },
      "optional": {},
      "additionalProperties": false
    },
    "ChatSubmissionAccepted": {
      "required": { "state": "literal:accepted", "turnId": "id", "assistantMessageId": "id", "assistantStatus": "enum:ChatMessageStatus", "runnerState": "enum:ChatRunnerState", "serverTime": "timestamp" },
      "optional": { "eventVersion": "integer", "lastSemanticActivityAt": "timestamp", "errorCode": "string", "errorMessage": "string", "completedAt": "timestamp" },
      "additionalProperties": false
    },
    "ChatCompactionAccepted": {
      "required": { "state": "enum-inline:accepted|already_running", "serverTime": "timestamp" },
      "optional": {},
      "additionalProperties": false
    },
    "ChatStopResult": {
      "required": { "stopped": "literal:true" },
      "optional": { "preparationPhase": "enum:ChatPreparationPhase", "turnId": "id", "state": "enum-inline:canceled|already_terminal", "assistantStatus": "enum:ChatMessageStatus" },
      "additionalProperties": false
    }
  },
  "commonErrors": [
    "auth_required",
    "session_expired",
    "must_change_password",
    "rate_limited",
    "system_api_busy",
    "internal_error"
  ],
  "errorCatalog": {
    "auth_required": { "status": 401, "code": null, "envelope": "json-error", "fixture": { "message": "请先登录" } },
    "session_expired": { "status": 401, "code": null, "envelope": "json-error", "fixture": { "message": "登录会话已过期" } },
    "must_change_password": { "status": 403, "code": "must_change_password", "envelope": "json-error", "fixture": { "message": "请先修改初始密码", "code": "must_change_password" } },
    "rate_limited": { "status": 429, "code": null, "envelope": "json-error", "fixture": { "message": "请求过于频繁，请稍后重试" } },
    "system_api_busy": { "status": 503, "code": "system_api_busy", "envelope": "json-error", "fixture": { "message": "系统管理接口繁忙，请稍后重试", "code": "system_api_busy" } },
    "request_body_invalid": { "status": 400, "code": null, "envelope": "json-error", "fixture": { "message": "请求体无效" } },
    "request_body_too_large": { "status": 413, "code": null, "envelope": "json-error", "fixture": { "message": "请求体过大" } },
    "chat_invalid_request": { "status": 400, "code": "chat_invalid_request", "envelope": "json-error", "fixture": { "message": "请求参数无效", "code": "chat_invalid_request" } },
    "chat_conversation_not_found": { "status": 404, "code": "chat_conversation_not_found", "envelope": "json-error", "fixture": { "message": "会话不存在", "code": "chat_conversation_not_found" } },
    "conversation_not_found_uncoded": { "status": 404, "code": null, "envelope": "json-error", "fixture": { "message": "会话不存在" } },
    "asset_not_found_uncoded": { "status": 404, "code": null, "envelope": "json-error", "fixture": { "message": "图片不存在或已过期" } },
    "chat_conversation_limit_exceeded": { "status": 409, "code": "chat_conversation_limit_exceeded", "envelope": "json-error", "fixture": { "message": "会话数量已达到上限，请先删除部分会话", "code": "chat_conversation_limit_exceeded" } },
    "chat_message_in_progress": { "status": 409, "code": "chat_message_in_progress", "envelope": "json-error", "fixture": { "message": "当前会话正在生成回答", "code": "chat_message_in_progress" } },
    "chat_context_compacting": { "status": 409, "code": "chat_context_compacting", "envelope": "json-error", "fixture": { "message": "当前会话正在压缩上下文", "code": "chat_context_compacting" } },
    "chat_conversation_clearing": { "status": 409, "code": "chat_conversation_clearing", "envelope": "json-error", "fixture": { "message": "当前会话正在清空", "code": "chat_conversation_clearing" } },
    "chat_storage_quota_exceeded": { "status": 409, "code": "chat_storage_quota_exceeded", "envelope": "json-error", "fixture": { "message": "聊天容量已达到上限，请先删除部分会话", "code": "chat_storage_quota_exceeded" } },
    "chat_replace_conflict": { "status": 409, "code": "chat_replace_conflict", "envelope": "json-error", "fixture": { "message": "最近一轮已变化，请重新确认后再编辑", "code": "chat_replace_conflict" } },
    "chat_turn_limit_exceeded": { "status": 409, "code": "chat_turn_limit_exceeded", "envelope": "json-error", "fixture": { "message": "当前会话轮次已达到上限，请新建会话继续提问", "code": "chat_turn_limit_exceeded" } },
    "no_compactable_turn": { "status": 409, "code": "no_compactable_turn", "envelope": "json-timed-error", "fixture": { "message": "当前会话没有可压缩的内容", "code": "no_compactable_turn", "serverTime": "<timestamp>" } },
    "chat_context_compaction_skipped": { "status": 409, "code": "chat_context_compaction_skipped", "envelope": "json-timed-error", "fixture": { "message": "当前会话没有可压缩的内容", "code": "chat_context_compaction_skipped", "serverTime": "<timestamp>" } },
    "chat_context_compaction_failed": { "status": 500, "code": "chat_context_compaction_failed", "envelope": "json-timed-error", "fixture": { "message": "上下文压缩启动失败，请稍后重试", "code": "chat_context_compaction_failed", "serverTime": "<timestamp>" } },
    "chat_model_capability_unavailable": { "status": 422, "code": "chat_model_capability_unavailable", "envelope": "json-error", "fixture": { "message": "当前模型不支持上下文压缩，请切换对话模型", "code": "chat_model_capability_unavailable" } },
    "chat_asset_invalid_request": { "status": 400, "code": "chat_asset_invalid_request", "envelope": "json-error", "fixture": { "message": "图片上传必须使用 multipart/form-data", "code": "chat_asset_invalid_request" } },
    "chat_asset_count_exceeded": { "status": 400, "code": "chat_asset_count_exceeded", "envelope": "json-error", "fixture": { "message": "每条消息最多 5 张图片，请移除图片后重试", "code": "chat_asset_count_exceeded" } },
    "chat_asset_too_large": { "status": 413, "code": "chat_asset_too_large", "envelope": "json-error", "fixture": { "message": "单张上传图片不能超过 1 MiB", "code": "chat_asset_too_large" } },
    "chat_asset_quota_exceeded": { "status": 413, "code": "chat_asset_quota_exceeded", "envelope": "json-error", "fixture": { "message": "聊天图片存储额度已满，请删除不用的会话或等待过期资产清理后重试", "code": "chat_asset_quota_exceeded" } },
    "chat_asset_unsupported_type": { "status": 415, "code": "chat_asset_unsupported_type", "envelope": "json-error", "fixture": { "message": "仅支持 JPEG、PNG、WebP 或 GIF 图片", "code": "chat_asset_unsupported_type" } },
    "chat_asset_not_deletable": { "status": 409, "code": "chat_asset_not_deletable", "envelope": "json-error", "fixture": { "message": "图片已发送、已删除或当前不能清理", "code": "chat_asset_not_deletable" } },
    "chat_model_not_found": { "status": 404, "code": "chat_model_not_found", "envelope": "json-error", "fixture": { "message": "当前会话没有可用的该模型", "code": "chat_model_not_found" } },
    "chat_message_too_large": { "status": 413, "code": null, "envelope": "json-error", "fixture": { "message": "消息内容超过 192 KiB 上限" } },
    "chat_message_already_exists": { "status": 409, "code": "chat_message_already_exists", "envelope": "json-error", "fixture": { "message": "该消息已提交，请刷新会话", "code": "chat_message_already_exists" } },
    "chat_image_not_supported": { "status": 422, "code": "chat_image_not_supported", "envelope": "json-error", "fixture": { "message": "当前模型或路由不支持图片输入，请切换模型或移除图片", "code": "chat_image_not_supported" } },
    "chat_request_body_too_large": { "status": 422, "code": "chat_request_body_too_large", "envelope": "json-error", "fixture": { "message": "本轮模型请求体仍超过安全上限，请减少图片或等待图片说明完成后重试", "code": "chat_request_body_too_large" } },
    "chat_input_exceeds_context": { "status": 422, "code": "chat_input_exceeds_context", "envelope": "json-error", "fixture": { "message": "当前输入超过模型上下文窗口，请缩短消息或减少图片后重试", "code": "chat_input_exceeds_context" } },
    "chat_asset_unavailable": { "status": 422, "code": "chat_asset_unavailable", "envelope": "json-error", "fixture": { "message": "图片不存在、尚未处理完成或已过期，请重新上传", "code": "chat_asset_unavailable" } },
    "chat_model_capability_mismatch": { "status": 422, "code": "chat_model_capability_mismatch", "envelope": "json-error", "fixture": { "message": "当前模型不支持所选思考级别，请重新选择", "code": "chat_model_capability_mismatch" } },
    "chat_context_unavailable": { "status": 422, "code": "chat_context_unavailable", "envelope": "json-error", "fixture": { "message": "历史图片语义说明仍在生成，请稍后重试", "code": "chat_context_unavailable" } },
    "chat_preparation_canceled": { "status": 499, "code": "chat_preparation_canceled", "envelope": "json-error", "fixture": { "message": "消息准备已取消", "code": "chat_preparation_canceled" } },
    "chat_generation_not_found": { "status": 404, "code": "chat_generation_not_found", "envelope": "json-error", "fixture": { "message": "当前没有匹配的生成任务", "code": "chat_generation_not_found" } },
    "chat_turn_mismatch": { "status": 409, "code": "chat_turn_mismatch", "envelope": "json-error", "fixture": { "message": "要停止的轮次已变化", "code": "chat_turn_mismatch" } },
    "chat_stream_terminal": { "status": 409, "code": "chat_stream_terminal", "envelope": "json-error", "fixture": { "message": "要附着的轮次已结束或已变化", "code": "chat_stream_terminal" } },
    "chat_stream_runner_missing": { "status": 409, "code": "chat_stream_runner_missing", "envelope": "json-error", "fixture": { "message": "生成任务已中断，请刷新会话", "code": "chat_stream_runner_missing" } },
    "internal_error": { "status": 500, "code": null, "envelope": "json-error", "fixture": { "message": "服务器内部错误" } }
  },
  "fixtures": {
    "conversation": {
      "id": "<conversation-id>",
      "systemAccountId": "<system-account-id>",
      "apiKeyId": "<api-key-id>",
      "apiKeyNameSnapshot": "默认 GPT Key",
      "defaultModel": { "id": "gpt-5.2", "name": "gpt-5.2" },
      "title": "新的对话",
      "isPinned": false,
      "lastModel": "gpt-5.2",
      "defaultImageModel": "gpt-image-2",
