  "semantics": {
    "idempotency": {
      "table": "chat_message_idempotency",
      "primaryKey": "PRIMARY KEY (conversation_id, client_message_id)",
      "lookupScope": "WHERE conversation_id = ? AND client_message_id = ? AND system_account_id = ?",
      "insertColumns": ["conversation_id", "client_message_id", "system_account_id", "turn_id", "user_message_id", "assistant_message_id", "created_at", "expires_at"],
      "duplicateResult": "duplicate: true",
      "replacementCardinality": ["deletedIdempotency.changes !== 1", "deletedMessages.changes !== 2"]
    },
    "cas": {
      "turn": {
        "activeTurnPredicate": "WHERE id = ? AND system_account_id = ? AND active_turn_id = ?",
        "assistantStreamingPredicate": "WHERE conversation_id = ? AND system_account_id = ? AND turn_id = ? AND role = 'assistant' AND status = 'streaming'",
        "successfulChangeCount": 1
      },
      "context": {
        "states": ["ready", "compact_pending", "compacting", "compact_failed"],
        "revisionPredicate": "id = ? AND system_account_id = ? AND context_revision = ?",
        "revisionPredicateOccurrences": 7,
        "claimIdentityFields": ["context_claim_id", "context_claim_revision", "context_claim_through_sequence", "context_progress_sequence"],
        "installPredicate": "AND context_state = 'compacting' AND context_claim_id = ? AND context_claim_revision = ? AND context_claim_through_sequence = ?",
        "successfulChangeCount": 1
      }
    },
