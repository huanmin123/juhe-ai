    },
    "originalAndPreview": {
      "table": "chat_assets",
      "originalColumns": ["original_bytes", "original_filename", "original_height", "original_mime_type", "original_sha256", "original_width"],
      "processedColumns": ["processed_bytes", "processed_height", "processed_mime_type", "processed_sha256", "processed_width", "storage_key"],
      "previewColumns": ["preview_bytes", "preview_height", "preview_mime_type", "preview_sha256", "preview_storage_key", "preview_width"],
      "generatedObjectsMustDiffer": "if (storageKey === previewStorageKey) throw new Error('生成图片原图与 preview 不能共用 storage key')",
