[Unit]
Description=juhe sing-box subscription refresh (hourly, change-detected)
After=sing-box.service

[Service]
Type=oneshot
# 家庭形态：本机 sing-box 系统服务、无 clash_api、健康门禁走本地 7890 socks 实测
Environment=JUHE_SB_BIN=/usr/bin/sing-box
Environment=JUHE_SB_UNIT=sing-box
Environment=JUHE_SB_API=
Environment=JUHE_SB_GROUP=auto
Environment=JUHE_SB_SOCKS_TEST=socks5h://127.0.0.1:7890
Environment=JUHE_SB_FETCH_VIA=direct,socks5h://127.0.0.1:7890
ExecStart=/usr/bin/python3 /usr/local/bin/juhe-sub-update.py
TimeoutStartSec=300
StandardOutput=append:/var/log/juhe-sub-update.log
StandardError=inherit
