[Unit]
Description=juhe sing-box selector optimizer (hysteresis best-node controller)
After=juhe-pw-proxy.service
Wants=juhe-pw-proxy.service

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 /usr/local/bin/juhe-proxy-switch.py
# 单次运行含探测超时，最坏情况分钟级；timer 在服务运行期间不会重复触发
TimeoutStartSec=300
# 目标服务器 journald 无持久化存储，控制器决策日志落文件（约 1 行/2 分钟）
StandardOutput=append:/var/log/juhe-proxy-switch.log
StandardError=inherit
