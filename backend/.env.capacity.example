# 聚合 AI 后端容量配置
# 复制为 backend/.env.capacity。运行时按以下优先级读取：进程环境变量 > JUHE_AI_ENV_FILE 覆盖文件 > .env.capacity > .env。
# 修改后完整重启对应的 server / worker。standalone 使用进程内池；performance 使用 Redis 跨实例共享池。批量参数只控制候选读取窗口。

# 上游请求、AI 账户状态任务和账户/探针调度唯一的业务并发上限。
JUHE_AI_CONCURRENCY_GLOBAL_MAX=5000
# Redis 共享槽的租约与排队轮询。仅 performance（Redis runtime state）生效。
JUHE_AI_CONCURRENCY_GLOBAL_LEASE_DURATION_MS=300000
JUHE_AI_CONCURRENCY_GLOBAL_ACQUIRE_POLL_MS=50
JUHE_AI_ACCOUNT_DEFAULT_CONCURRENCY_LIMIT=5000
JUHE_AI_ACCOUNT_SLOT_LEASE_DURATION_MS=90000
JUHE_AI_ACCOUNT_SLOT_REFRESH_INTERVAL_MS=15000

# 仅供日志、审计、IPC 等非请求后台资源使用的默认并发；不作用于上游请求、账户状态或调度。
JUHE_AI_CONCURRENCY_BACKGROUND_DEFAULT_MAX=20

