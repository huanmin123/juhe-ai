{
  "name": "juhe-ai-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "check:runtime": "tsx src/scripts/preflight/check-node-sqlite.ts",
    "dev": "tsx src/scripts/preflight/check-node-sqlite.ts && tsx watch src/server.ts",
    "test:smoke": "tsx src/scripts/smoke/smoke-test.ts",
    "test:perf": "tsx src/scripts/performance/gateway-performance-test.ts",
    "test:scope": "tsx src/scripts/regression/scope-boundary-regression.ts",
    "test:proxy-negative": "tsx src/scripts/regression/proxy-negative-regression.ts",
    "test:large-response": "node --expose-gc --import tsx src/scripts/regression/non-stream-large-response-regression.ts",
    "test:stream-first-output-timeout": "tsx src/scripts/regression/stream-first-output-timeout-regression.ts",
    "test:codex-client-strategy": "tsx src/scripts/regression/codex-client-strategy-regression.ts",
    "test:codex-turn-switch-e2e": "tsx src/scripts/regression/codex-turn-account-switch-e2e-regression.ts",
    "test:smoke:mock": "tsx src/scripts/regression/codex-turn-account-switch-e2e-regression.ts",
    "test:db-service-worker-local": "tsx src/scripts/regression/db-service-worker-local-regression.ts",
    "test:db-service-system-api-boundary": "tsx src/scripts/regression/db-service-system-api-boundary-regression.ts",
    "test:db-service-system-api-http": "tsx src/scripts/regression/db-service-system-api-http-regression.ts",
    "test:disabled-account-state-guard": "tsx src/scripts/regression/disabled-account-state-guard-regression.ts",
    "test:account-quality-refresh": "tsx src/scripts/regression/account-quality-refresh-regression.ts",
    "test:account-list-stable-sort": "tsx src/scripts/regression/account-list-stable-sort-regression.ts",
    "test:session-affinity": "tsx src/scripts/regression/session-affinity-regression.ts",
    "test:audit-log-retention": "tsx src/scripts/regression/audit-log-retention-regression.ts",
    "test:operation-log-queue": "tsx src/scripts/regression/operation-log-queue-regression.ts",
    "test:record-maintenance-queue": "tsx src/scripts/regression/record-maintenance-queue-regression.ts",
    "test:usage-pricing": "tsx src/scripts/regression/usage-pricing-regression.ts",
    "test:openai-oauth-codex-adapter": "tsx src/scripts/regression/openai-oauth-codex-adapter-regression.ts",
    "test:openai-oauth-access-token-refresh": "tsx src/scripts/regression/openai-oauth-access-token-refresh-regression.ts",
    "test:openai-api-key-passthrough": "tsx src/scripts/regression/openai-api-key-passthrough-regression.ts",
    "test:runtime-log-grep-path": "tsx src/scripts/regression/runtime-log-grep-path-regression.ts",
    "test:runtime-log-index-large-line": "tsx src/scripts/regression/runtime-log-index-large-line-regression.ts",
    "test:gateway-runtime-cache": "tsx src/scripts/regression/gateway-runtime-cache-regression.ts",
    "test:gateway-concurrency-snapshot": "tsx src/scripts/regression/gateway-concurrency-snapshot-regression.ts",
    "test:runtime-config-env-override": "tsx src/scripts/regression/runtime-config-env-override-regression.ts",
    "test:api-key-single-read": "tsx src/scripts/regression/api-key-single-read-regression.ts",
    "test:group-single-read": "tsx src/scripts/regression/group-single-read-regression.ts",
    "test:system-team-single-read": "tsx src/scripts/regression/system-team-single-read-regression.ts",
    "clean:dist": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "pnpm run clean:dist && tsc -p tsconfig.json",
    "start": "node dist/scripts/preflight/check-node-sqlite.js && node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "engines": {
    "node": ">=22.13.0 <23 || >=24.11.0 <25"
  },
  "dependencies": {
    "@vscode/ripgrep": "1.18.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "https-proxy-agent": "^9.0.0",
    "lru-cache": "^11.3.5",
    "pino": "^10.3.1",
    "socks-proxy-agent": "^10.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
