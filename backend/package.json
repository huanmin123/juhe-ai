{
  "name": "juhe-ai-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "test:smoke": "tsx src/scripts/smoke-test.ts",
    "test:scope": "tsx src/scripts/scope-boundary-regression.ts",
    "test:proxy-negative": "tsx src/scripts/proxy-negative-regression.ts",
    "test:large-response": "node --expose-gc --import tsx src/scripts/non-stream-large-response-regression.ts",
    "test:stream-first-output-timeout": "tsx src/scripts/stream-first-output-timeout-regression.ts",
    "test:db-service-worker-local": "tsx src/scripts/db-service-worker-local-regression.ts",
    "test:disabled-account-state-guard": "tsx src/scripts/disabled-account-state-guard-regression.ts",
    "test:account-list-stable-sort": "tsx src/scripts/account-list-stable-sort-regression.ts",
    "test:session-affinity": "tsx src/scripts/session-affinity-regression.ts",
    "test:audit-log-retention": "tsx src/scripts/audit-log-retention-regression.ts",
    "test:usage-pricing": "tsx src/scripts/usage-pricing-regression.ts",
    "test:openai-oauth-codex-adapter": "tsx src/scripts/openai-oauth-codex-adapter-regression.ts",
    "test:openai-api-key-passthrough": "tsx src/scripts/openai-api-key-passthrough-regression.ts",
    "stats:rebuild": "tsx src/scripts/rebuild-usage-stats.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "https-proxy-agent": "^9.0.0",
    "lru-cache": "^11.3.5",
    "pino": "^10.3.1",
    "socks-proxy-agent": "^10.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
