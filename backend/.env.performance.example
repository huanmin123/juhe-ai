# 聚合 AI 后端高性能模式覆盖配置
# 复制为 backend/.env.performance 后修改，并在 backend/.env 中启用：
# JUHE_AI_ENV_FILE=./.env.performance
#
# 本文件只放 PostgreSQL / Redis / Redis Stream / 高并发阈值等性能节点差异项。
# 通用配置继续放 backend/.env，例如端口、密钥、Cookie、日志、上游安全和 smoke 配置。

JUHE_AI_RUNTIME_MODE=performance
JUHE_AI_DATABASE_DRIVER=postgres
JUHE_AI_CACHE_DRIVER=redis
JUHE_AI_RUNTIME_STATE_DRIVER=redis
JUHE_AI_QUEUE_DRIVER=redis_stream

# production performance 模式必须显式提供跨重启稳定、且与同机其他 Node 进程不同的实例 ID。
# launchd / systemd 多进程部署时，每个 control、gateway 或 worker 都要有自己的稳定值。
JUHE_AI_INSTANCE_ID=juhe-ai-control-1

# 同机 Node 多进程拓扑、队列批次、数据库连接池与并发上限统一在 backend/.env.capacity。

# 非 Docker 部署时通常连接本机或内网 PgBouncer / Redis。
# Docker Compose 部署请使用 docker/.env.performance.example，而不是这个 backend 覆盖文件。
JUHE_AI_POSTGRES_URL=postgres://juhe_ai:强密码@127.0.0.1:6432/juhe_ai
JUHE_AI_REDIS_CACHE_URL=redis://:强密码@127.0.0.1:6379/0
JUHE_AI_REDIS_STATE_URL=redis://:强密码@127.0.0.1:6380/0

# 队列 Redis 独立于 redis-state，使用 noeviction + AOF everysec 承接可靠队列。
JUHE_AI_REDIS_QUEUE_URL=redis://:强密码@127.0.0.1:6381/0
# Redis key 会自动按 JUHE_AI_SECRET 派生命名空间；生产多环境共用 Redis 集群时建议显式填写。
JUHE_AI_REDIS_NAMESPACE=prod
# 默认禁止 cache/state/queue 指向同一个 Redis DB；仅临时排障明确接受风险时才改 true。

# Redis queue 短暂不可用时的本机持久补偿。裸机部署必须改为 release 外的共享绝对路径。
JUHE_AI_USAGE_SPOOL_DIR=./data/usage-spool

# 高性能网关正常阶段详情按 trace 稳定采样；失败现场与每请求 timing summary 不采样。
JUHE_AI_GATEWAY_TIMING_DETAIL_SAMPLE_PERMILLE=50
JUHE_AI_GATEWAY_STAGE_PRESSURE_MAX_PENDING_MB=8

# 高性能节点的连接池和写入容量也配置在 backend/.env.capacity；最终以压测、PgBouncer pool 和机器资源为准。
JUHE_AI_POSTGRES_STATEMENT_TIMEOUT_MS=30000
JUHE_AI_POSTGRES_LOCK_TIMEOUT_MS=2000
JUHE_AI_POSTGRES_IDLE_IN_TRANSACTION_TIMEOUT_MS=30000
# OLTP 读路径默认关闭 JIT，避免复杂分页查询在冷连接上产生编译长尾。
JUHE_AI_POSTGRES_JIT_ENABLED=false

# 后台、网关、数据库和 Redis 的批次 / 并发 / 队列容量统一放在 backend/.env.capacity。
# 高性能节点可复制 backend/.env.capacity.example 为 backend/.env.capacity；账户状态、上游请求和调度只调整全局共享池，其他键仅调整存储/队列资源容量。
