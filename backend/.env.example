# 聚合 AI 后端本地配置
# 复制为 backend/.env 后修改；配置随项目目录走，不依赖系统环境变量。
# 相对路径按 backend/ 目录解析，拷贝整个项目到其他电脑或服务器后仍可直接使用。
# 注意：JUHE_AI_SECRET 会影响已入库敏感字段解密，迁移已有数据库时必须保持不变。

# 后端监听地址。本机自用用 127.0.0.1；需要被局域网、容器或反向代理访问时可改为 0.0.0.0。
JUHE_AI_HOST=127.0.0.1

# 后端监听端口。
JUHE_AI_PORT=3000

# 进程角色。主服务必须保持 server；server 启动后会自动拉起独立后台 worker 进程。
# 不要把主服务的常驻配置改成 worker，否则只会跑后台任务，不会监听 Web/API 端口。
JUHE_AI_PROCESS_ROLE=server

# SQLite 数据库路径。相对路径按 backend/ 目录解析；默认会自动创建 backend/data/juhe-ai.sqlite3。
JUHE_AI_DATABASE_PATH=./data/juhe-ai.sqlite3

# 数据加密密钥。已有数据库迁移时不要改，否则 OAuth token、上游 API Key、代理密码会无法解密。
JUHE_AI_SECRET=juhe-ai-dev-secret-change-me

# 可选：OAuth token 换取/刷新时使用的兜底代理；留空表示直连。具体账号代理优先在代理管理页绑定。
JUHE_AI_OAUTH_PROXY_URL=

# 后端普通运行日志配置。普通日志只保存安全摘要和链路 ID，不保存完整请求体、响应体或凭据原文。
JUHE_AI_LOG_LEVEL=info
JUHE_AI_LOG_DIR=./logs
JUHE_AI_LOG_FILE_ENABLED=true
JUHE_AI_LOG_CONSOLE_ENABLED=true
JUHE_AI_LOG_MAX_FILE_MB=100
JUHE_AI_LOG_RETENTION_DAYS=14
JUHE_AI_LOG_MAX_FILES=30
JUHE_AI_LOG_CLEANUP_INTERVAL_MINUTES=60

# 烟测后端地址。只影响 pnpm test:smoke，不影响正常启动和网关转发。
JUHE_AI_BACKEND_URL=http://127.0.0.1:3000

# 烟测登录管理员账号。烟测会走真实登录、创建临时分组和 API Key，再请求网关。
JUHE_AI_SMOKE_ADMIN_USERNAME=admin
JUHE_AI_SMOKE_ADMIN_PASSWORD=admin

# 烟测目标账号名。留空会自动选择第一个启用并且可用的 OpenAI 账号；需要固定某个账号时填写账户页里的名称。
JUHE_AI_SMOKE_ACCOUNT_NAME=

# 烟测请求模型。只影响 pnpm test:smoke，需确保目标账号可调用该模型。
JUHE_AI_SMOKE_MODEL=gpt-5.4-mini

# 烟测请求提示词。只影响 pnpm test:smoke。
JUHE_AI_SMOKE_PROMPT=只输出 OK
