# 聚合 AI 后端本地配置
# 复制为 backend/.env 后修改；同名进程环境变量可临时覆盖本文件，便于隔离烟测、容器和托管平台注入配置。
# 相对路径按 backend/ 目录解析，拷贝整个项目到其他电脑或服务器后仍可直接使用。
# 注意：JUHE_AI_SECRET 会影响当前业务库中敏感字段解密；如果解密失败，请按当前 schema 离线修复或重建业务数据。

# 可选：加载一个专用覆盖配置文件。推荐 backend/.env 只放通用 / standalone 配置，
# 高性能节点复制 backend/.env.performance.example 为 backend/.env.performance 后再启用下面这一行。
# JUHE_AI_ENV_FILE=./.env.performance

# 后端监听地址。本机自用用 127.0.0.1；需要被局域网、容器或反向代理访问时可改为 0.0.0.0。
JUHE_AI_HOST=127.0.0.1

# 后端监听端口。
JUHE_AI_PORT=3000

# DB service 内部系统 API 监听地址和端口。默认只绑定本机，端口 0 表示自动选择空闲端口。
# 主进程会通过该内部地址代理 /__aisys__/api/*，通常不需要手动修改，也不要暴露到公网。
JUHE_AI_DB_SERVICE_HTTP_HOST=127.0.0.1
JUHE_AI_DB_SERVICE_HTTP_PORT=0

# 进程角色。主服务必须保持 server；server 启动后会自动拉起独立后台 worker 进程。
# 不要把主服务的常驻配置改成 worker，否则只会跑后台任务，不会监听 Web/API 端口。
JUHE_AI_PROCESS_ROLE=server

# 运行模式。默认 standalone 使用 SQLite + 内存缓存；performance 使用 PostgreSQL + Redis。
# 高性能模式必须同时配置 JUHE_AI_POSTGRES_URL、JUHE_AI_REDIS_CACHE_URL、JUHE_AI_REDIS_STATE_URL 和 JUHE_AI_REDIS_QUEUE_URL。
JUHE_AI_RUNTIME_MODE=standalone
JUHE_AI_DATABASE_DRIVER=sqlite
JUHE_AI_CACHE_DRIVER=memory
JUHE_AI_RUNTIME_STATE_DRIVER=memory
JUHE_AI_QUEUE_DRIVER=memory

# PostgreSQL / Redis / Redis Stream / 高并发阈值属于高性能专用配置，不放在主配置里。
# 普通 standalone 节点 System API DB service 在途上限默认 64；performance 节点默认 256。
# 需要高性能模式时，使用 backend/.env.performance.example 或 docker/.env.performance.example。

# SQLite 业务库路径。相对路径按 backend/ 目录解析；默认会自动创建 backend/data/juhe-ai.sqlite3。
JUHE_AI_DATABASE_PATH=./data/juhe-ai.sqlite3

# SQLite 数据集目录库路径。用于承载审计、日志索引、操作日志、模型检测明细和清理目标。
# 默认备份不包含统计相关数据；数据集目录库可清空、重建或丢弃。
JUHE_AI_DATASET_DATABASE_PATH=./data/juhe-ai-dataset.sqlite3

# SQLite 使用记录目录库路径。用于承载 usage shard 注册表、列表筛选目录和账号 / API Key scope catalog。
JUHE_AI_USAGE_CATALOG_DATABASE_PATH=./data/juhe-ai-usage-catalog.sqlite3

# SQLite 统计结果库路径。用于承载用量统计、额度窗口、排行快照、账号质量和监控趋势等紧凑结果。
# 统计结果库可从 usage shard 和仍保留的数据集目录库事实重建；没有历史事实时从新请求重新累计。
JUHE_AI_STATS_DATABASE_PATH=./data/juhe-ai-stats.sqlite3

# usage_records 分片目录。新写入的使用记录会按日期和稳定 hash 写入多个 SQLite shard 文件。
# 留空时，会跟随数据集目录库所在目录生成 usage-shards；显式配置便于备份或扩容。
JUHE_AI_USAGE_SHARD_ROOT=./data/usage-shards

# usage shard 数量。生产启用后不要直接改小；扩容需要单独 rebalance 方案。
JUHE_AI_USAGE_SHARD_COUNT=16

# 数据加密密钥。复用当前业务库时不要改，否则 OAuth token、上游 API Key、代理密码会无法解密。
# 开发环境留空会使用内置开发密钥；NODE_ENV=production 时必须显式配置至少 32 位稳定随机密钥，否则拒绝启动。
JUHE_AI_SECRET=

# 后台跨域白名单。开发环境留空可支持本地前端联调；NODE_ENV=production 时必须填写完整 Origin，多个用英文逗号分隔。
# 示例：JUHE_AI_ALLOWED_ORIGINS=https://admin.example.com
JUHE_AI_ALLOWED_ORIGINS=

# 登录会话 Cookie 安全属性。生产默认 Secure=true，开发默认 false；SameSite 可选 lax、strict、none。
# SameSite=None 必须同时启用 JUHE_AI_COOKIE_SECURE=true。
JUHE_AI_COOKIE_SECURE=
JUHE_AI_COOKIE_SAME_SITE=lax

# 反向代理信任配置。默认 false；放在 HTTPS 反向代理后且需要 Express 识别代理协议时，可设 true 或 1-16 的代理跳数。
JUHE_AI_TRUST_PROXY=false

# 上游 Base URL SSRF 防护。默认拒绝本机、内网、链路本地和保留地址；生产环境不能开启下面两个本地放行配置。
# 仅本地回归或 mock 上游联调需要时，才临时设置 JUHE_AI_ALLOW_PRIVATE_UPSTREAM_BASE_URLS=true 或逐项填写 allowlist。
JUHE_AI_ALLOW_PRIVATE_UPSTREAM_BASE_URLS=false
JUHE_AI_UPSTREAM_BASE_URL_PRIVATE_ALLOWLIST=

# 模型检测探针重试。正常探针不做人为并发限制；失败后默认等待一分钟以上再重试。
JUHE_AI_MODEL_CHECK_PROBE_RETRY_DELAY_MS=65000

# 可选：OAuth token 换取/刷新时使用的兜底代理；留空表示直连。具体账号代理优先在代理管理页绑定。
JUHE_AI_OAUTH_PROXY_URL=

# OpenAI hosted tools 运行时模式。默认 guidance 表示返回可消费的能力缺口说明，不执行本地工具、不请求不支持的上游。
# 可选值：guidance、reject、mock、local_runtime。mock 只用于回归；local_runtime 必须配套对应执行器和安全边界。
JUHE_AI_HOSTED_TOOL_CODE_INTERPRETER_MODE=guidance
JUHE_AI_HOSTED_TOOL_COMPUTER_MODE=guidance
JUHE_AI_HOSTED_TOOL_SHELL_MODE=guidance
JUHE_AI_HOSTED_TOOL_SKILLS_MODE=guidance
JUHE_AI_HOSTED_TOOL_TOOL_SEARCH_MODE=guidance

# Code interpreter local_runtime 首段配置。只有 JUHE_AI_HOSTED_TOOL_CODE_INTERPRETER_MODE=local_runtime 时生效。
# 当前执行器使用独立 Python 子进程、临时目录、超时和输出上限；生产级隔离仍建议放进容器 / VM 沙箱。
JUHE_AI_CODE_INTERPRETER_PYTHON_COMMAND=python
JUHE_AI_CODE_INTERPRETER_TIMEOUT_MS=5000
JUHE_AI_CODE_INTERPRETER_MAX_CODE_KB=64
JUHE_AI_CODE_INTERPRETER_MAX_OUTPUT_KB=64
JUHE_AI_CODE_INTERPRETER_MAX_ARTIFACTS=8
JUHE_AI_CODE_INTERPRETER_MAX_ARTIFACT_KB=256
JUHE_AI_CODE_INTERPRETER_TEMP_ROOT=./data/code-interpreter-tmp
JUHE_AI_CODE_INTERPRETER_CLEANUP_TEMP_DIR=true

# Computer local_runtime HTTP sandbox adapter。默认关闭；只在外部受控浏览器 / container browser 服务准备好后开启。
# endpoint 使用 http 时只能指向 127.0.0.1 / localhost / ::1；远程 sandbox adapter 必须使用 https，且不能带用户名密码、query 或 fragment。
JUHE_AI_COMPUTER_BROWSER_ADAPTER_ENABLED=false
JUHE_AI_COMPUTER_BROWSER_ADAPTER_ENDPOINT=
JUHE_AI_COMPUTER_BROWSER_ADAPTER_TIMEOUT_MS=30000
JUHE_AI_COMPUTER_BROWSER_ADAPTER_MAX_BODY_KB=512

# 后端普通运行日志配置。普通日志只保存安全摘要和链路 ID，不保存完整请求体、响应体或凭据原文。
JUHE_AI_LOG_LEVEL=info
JUHE_AI_LOG_DIR=./logs
JUHE_AI_LOG_FILE_ENABLED=true
JUHE_AI_LOG_CONSOLE_ENABLED=true
JUHE_AI_LOG_MAX_FILE_MB=100
JUHE_AI_LOG_RETENTION_DAYS=30
JUHE_AI_LOG_MAX_FILES=500
JUHE_AI_LOG_CLEANUP_INTERVAL_MINUTES=60

# 烟测后端地址。只影响 pnpm test:smoke，不影响正常启动和网关转发。
# 当前 smoke 会在脚本进程校验管理员凭据并写入短时会话，因此该地址必须指向共享同一 JUHE_AI_DATABASE_PATH 和 JUHE_AI_SECRET 的本机后端。
JUHE_AI_BACKEND_URL=http://127.0.0.1:3000

# 烟测管理员账号。烟测会校验本地管理员凭据并创建同库短时会话，再创建临时分组和 API Key 请求网关。
JUHE_AI_SMOKE_ADMIN_USERNAME=admin
JUHE_AI_SMOKE_ADMIN_PASSWORD=admin

# 烟测目标账号名。留空会自动选择第一个启用并且可用的 OpenAI 账号；需要固定某个账号时填写账户页里的名称。
JUHE_AI_SMOKE_ACCOUNT_NAME=

# 烟测请求模型。只影响 pnpm test:smoke，需确保目标账号可调用该模型。
JUHE_AI_SMOKE_MODEL=gpt-5.4-mini

# 烟测请求提示词。只影响 pnpm test:smoke。
JUHE_AI_SMOKE_PROMPT=只输出 OK
