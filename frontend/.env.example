# 聚合 AI 前端本地配置
# 复制为 frontend/.env 后修改；配置随项目目录走，不依赖系统环境变量。

# 开发代理目标。只影响 pnpm dev；前端开发服务器会把 /__aisys__/api 和 /v1 转发到这里。
# backend-go gateway 主入口监听同一默认端口约定（JUHE_AI_HOST:JUHE_AI_PORT，缺省 127.0.0.1:3000）；
# 本地 Go gateway 监听其他端口时直接改这里，例如 http://127.0.0.1:3100。
VITE_JUHE_AI_BACKEND_TARGET=http://127.0.0.1:3000

# 前端后端连接模式：node（默认）或 go。
# go 表示当前构建/开发代理指向 backend-go gateway 主入口；缺省或 node 时行为与历史版本完全一致。
# go 模式下未在 Go gateway 挂载的管理前缀（审计日志、运行日志、公共 API 日志、授权选项、
# 统计、使用记录、代理配置、表监控、ui-bootstrap 等）会 404 或依赖 legacy bridge 回落 Node，
# 详见 docs/migration/X04-前端Go模式收口与契约差异清单.md。
#VITE_JUHE_AI_DEPLOY_MODE=node

# J3b 模型检测开发代理目标（可选）。模型检测 API 由独立 Go J3b Gateway 管理入口提供
# （JUHE_AI_J3B_MANAGEMENT_LISTEN_ADDRESS，缺省 127.0.0.1:3307），Node 主后端与 Go gateway
# 主入口都不挂载。设置后 dev 服务器会把 /__aisys__/api/model-checks 与 /__aisys__/api/my-model-checks
# 转发到该入口；不设置则不产生该代理条目。构建 J3b 专用包仍需同时注入 VITE_JUHE_AI_J3B_ENABLED=true。
#VITE_JUHE_AI_J3B_BACKEND_TARGET=http://127.0.0.1:3307

# 前端管理 API 请求地址。前后端同源部署保持 /__aisys__/api；分离部署时改成 http(s)://你的后端/__aisys__/api。
VITE_JUHE_AI_API_BASE_URL=/__aisys__/api

# API Key 页面展示和复制的网关 Base URL。留空时自动按当前访问地址推断；分离部署或公网访问时可填写完整网关根地址或 /v1 地址。
VITE_JUHE_AI_GATEWAY_BASE_URL=
