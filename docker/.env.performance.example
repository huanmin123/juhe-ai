# 复制为 docker/.env.performance 后按需修改。
# 启动命令：
# docker compose --env-file .env.performance -f compose.performance.yml up -d --build

NODE_ENV=production

# 应用访问端口和后台 Origin。高性能模式默认按宿主机 Caddy/HTTPS 反代配置。
JUHE_AI_PUBLIC_BIND=127.0.0.1
JUHE_AI_PUBLIC_PORT=3000
JUHE_AI_PORT=3000
JUHE_AI_PUBLIC_ORIGIN=https://ai.example.com
JUHE_AI_ALLOWED_ORIGINS=

# 生产必须填写稳定随机密钥；如离线保留已按当前 schema 准备好的数据，必须沿用原 JUHE_AI_SECRET。
JUHE_AI_SECRET=
JUHE_AI_COOKIE_SECURE=true
JUHE_AI_COOKIE_SAME_SITE=lax
JUHE_AI_TRUST_PROXY=true
JUHE_AI_OAUTH_PROXY_URL=

# 镜像与容器名。
JUHE_AI_IMAGE=juhe-ai:local
JUHE_AI_CONTAINER_NAME=juhe-ai-performance
JUHE_AI_NODE_IMAGE=node:22-bookworm-slim
JUHE_AI_POSTGRES_IMAGE=postgres:18-bookworm
JUHE_AI_PGBOUNCER_IMAGE=edoburu/pgbouncer:v1.25.2-p0
JUHE_AI_REDIS_IMAGE=redis:8.2.7-bookworm

# 如果服务器不能直连 Docker Hub，可以在部署环境覆盖为镜像源地址。
# 例如国内服务器可按实际网络情况替换为可访问的镜像源：
# JUHE_AI_POSTGRES_IMAGE=docker.m.daocloud.io/postgres:18-bookworm
# JUHE_AI_REDIS_IMAGE=docker.m.daocloud.io/redis:8.2.7-bookworm
# PgBouncer 可先从 docker.1ms.run/edoburu/pgbouncer:v1.25.2-p0 拉取后本地 tag 为 edoburu/pgbouncer:v1.25.2-p0。

# PostgreSQL / PgBouncer。中间件发布端口默认只绑定本机，远端访问请走 SSH/VPN 或安全组白名单。
JUHE_AI_MIDDLEWARE_BIND=127.0.0.1
JUHE_AI_POSTGRES_DB=juhe_ai
JUHE_AI_POSTGRES_USER=juhe_ai
JUHE_AI_POSTGRES_PASSWORD=
JUHE_AI_POSTGRES_PORT=5432
JUHE_AI_PGBOUNCER_PORT=6432
JUHE_AI_PGBOUNCER_POOL_MODE=transaction
JUHE_AI_PGBOUNCER_MAX_CLIENT_CONN=1000
JUHE_AI_PGBOUNCER_DEFAULT_POOL_SIZE=50
JUHE_AI_PGBOUNCER_RESERVE_POOL_SIZE=20

# Redis cache 可淘汰；Redis state 不允许随机淘汰。
JUHE_AI_REDIS_CACHE_PASSWORD=
JUHE_AI_REDIS_STATE_PASSWORD=
JUHE_AI_REDIS_CACHE_PORT=6379
JUHE_AI_REDIS_STATE_PORT=6380
JUHE_AI_REDIS_CACHE_MAXMEMORY=512mb
JUHE_AI_REDIS_STATE_MAXMEMORY=512mb

# 应用高性能模式。
JUHE_AI_RUNTIME_MODE=performance
JUHE_AI_DATABASE_DRIVER=postgres
JUHE_AI_CACHE_DRIVER=redis
JUHE_AI_RUNTIME_STATE_DRIVER=redis
JUHE_AI_QUEUE_DRIVER=redis_stream
JUHE_AI_POSTGRES_URL=
JUHE_AI_REDIS_CACHE_URL=
JUHE_AI_REDIS_STATE_URL=
# 必须显式填写；可以与 JUHE_AI_REDIS_STATE_URL 使用同一个 Redis，也可以拆到独立队列 Redis。
JUHE_AI_REDIS_QUEUE_URL=
JUHE_AI_REDIS_STREAM_MAXLEN=1000000
JUHE_AI_REDIS_STREAM_READ_COUNT=1000
JUHE_AI_REDIS_STREAM_BLOCK_MS=1000
JUHE_AI_REDIS_STREAM_CLAIM_IDLE_MS=60000
JUHE_AI_SYSTEM_API_DB_SERVICE_MAX_IN_FLIGHT=256
JUHE_AI_DB_POOL_MAX=150
JUHE_AI_DB_WRITE_MAX_CONCURRENCY=100
JUHE_AI_DB_WRITE_QUEUE_MAX_ITEMS=50000

# 本地文件仍用于日志、临时文件、审计 blob、上下文文件等非数据库内容。
# SQLite 文件路径在 performance 模式下主要用于本地兼容和非 PG 产物，仍保持互不冲突。
JUHE_AI_DATABASE_PATH=/app/backend/data/juhe-ai.sqlite3
JUHE_AI_DATASET_DATABASE_PATH=/app/backend/data/juhe-ai-dataset.sqlite3
JUHE_AI_USAGE_CATALOG_DATABASE_PATH=/app/backend/data/juhe-ai-usage-catalog.sqlite3
JUHE_AI_STATS_DATABASE_PATH=/app/backend/data/juhe-ai-stats.sqlite3
JUHE_AI_USAGE_SHARD_ROOT=/app/backend/data/usage-shards
JUHE_AI_USAGE_SHARD_COUNT=16
JUHE_AI_LOG_DIR=/app/backend/logs
JUHE_AI_LOG_FILE_ENABLED=true
JUHE_AI_LOG_CONSOLE_ENABLED=true
