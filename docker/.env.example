# 复制为 docker/.env 后按需修改；不复制也可以直接使用默认值启动。
# docker compose 会自动读取当前 docker 目录下的 .env 文件。

# 宿主机访问端口。容器内服务端口默认同为 3000。
# 默认只绑定本机，配合宿主机反向代理或本机验证；局域网临时 HTTP 验证才改为 0.0.0.0。
JUHE_AI_PUBLIC_BIND=127.0.0.1
JUHE_AI_PUBLIC_PORT=3000
JUHE_AI_PORT=3000

# 公网或域名访问时填写完整 Origin，例如 http://你的服务器IP:3000 或 https://ai.example.com。
# 留空时默认允许 http://localhost:端口 和 http://127.0.0.1:端口。
JUHE_AI_PUBLIC_ORIGIN=
JUHE_AI_ALLOWED_ORIGINS=

# 留空时容器首次启动会在数据卷里生成 /app/backend/data/.juhe-ai-secret 并复用。
# 迁移已有数据时必须填写原来的 JUHE_AI_SECRET，否则敏感字段无法解密。
JUHE_AI_SECRET=

# 直接用 HTTP 访问时保持 false；HTTPS 反向代理后建议改 true。
JUHE_AI_COOKIE_SECURE=false
JUHE_AI_COOKIE_SAME_SITE=lax
JUHE_AI_TRUST_PROXY=false

# 可选：OpenAI OAuth token 换取 / 刷新的兜底代理。
# 普通上游模型请求仍建议在后台“代理管理”创建代理并绑定到 AI 账户。
# 裸机同机示例：socks5h://127.0.0.1:7890
# Docker Desktop 访问宿主机 sing-box 示例：socks5h://host.docker.internal:7890
JUHE_AI_OAUTH_PROXY_URL=

# 模型检测探针重试。正常探针不做人为并发限制；失败后默认等待一分钟以上再重试。
JUHE_AI_MODEL_CHECK_PROBE_RETRY_DELAY_MS=65000

# 镜像和容器名可按需覆盖。
JUHE_AI_IMAGE=juhe-ai:local
JUHE_AI_CONTAINER_NAME=juhe-ai

# 默认单容器 standalone 模式使用 SQLite + 内存缓存。
# 高性能模式请复制 .env.performance.example，并使用 compose.performance.yml。
JUHE_AI_RUNTIME_MODE=standalone
JUHE_AI_DATABASE_DRIVER=sqlite
JUHE_AI_CACHE_DRIVER=memory
JUHE_AI_RUNTIME_STATE_DRIVER=memory
JUHE_AI_QUEUE_DRIVER=memory

# 原始审计保全策略；正文上限为 0 时使用 hash_only。
JUHE_AI_AUDIT_LOG_SUCCESS_HOT_RETENTION_HOURS=1
JUHE_AI_AUDIT_LOG_SUCCESS_SAMPLE_RATE=0.1
JUHE_AI_AUDIT_LOG_SUCCESS_RETENTION_DAYS=3
JUHE_AI_AUDIT_LOG_PROBLEM_RETENTION_DAYS=7
JUHE_AI_AUDIT_LOG_SUCCESS_FULL_BODY_LIMIT_KB=512
JUHE_AI_AUDIT_LOG_PROBLEM_FULL_BODY_LIMIT_KB=2048

# Docker Hub 拉取慢或不可用时，可覆盖为可访问的 Node 22 slim 镜像。
JUHE_AI_NODE_IMAGE=node:22-bookworm-slim

# 后端数据、日志和 usage shard 默认都在 Docker volume 内。
# 一般不需要修改这些路径，除非你明确要挂载到自定义目录。
# JUHE_AI_DATABASE_PATH=/app/backend/data/juhe-ai.sqlite3
# JUHE_AI_DATASET_DATABASE_PATH=/app/backend/data/juhe-ai-dataset.sqlite3
# JUHE_AI_USAGE_CATALOG_DATABASE_PATH=/app/backend/data/juhe-ai-usage-catalog.sqlite3
# JUHE_AI_STATS_DATABASE_PATH=/app/backend/data/juhe-ai-stats.sqlite3
# JUHE_AI_USAGE_SHARD_ROOT=/app/backend/data/usage-shards
# JUHE_AI_LOG_DIR=/app/backend/logs
