# 首次启动必须复制为 docker/.env 并填写 F3 input secret；Compose 会拒绝空值，不能直接使用默认配置启动。
# docker compose 会自动读取当前 docker 目录下的 .env 文件。

# 进程墙上时钟固定为 UTC；绝对时间接口只使用 RFC3339 Z/显式 offset。
# 统计日界线等业务日历必须单独使用显式 IANA timezone。
JUHE_AI_USAGE_STATS_TIMEZONE=UTC

# 宿主机访问端口。容器内服务端口默认同为 3000。
# 默认只绑定本机，配合宿主机反向代理或本机验证；局域网临时 HTTP 验证才改为 0.0.0.0。
JUHE_AI_PUBLIC_BIND=127.0.0.1
JUHE_AI_PUBLIC_PORT=3000
JUHE_AI_PORT=3000

# 公网或域名访问时填写完整 Origin，例如 http://你的服务器IP:3000 或 https://ai.example.com。
# 留空时默认允许 http://localhost:端口 和 http://127.0.0.1:端口。
JUHE_AI_PUBLIC_ORIGIN=
JUHE_AI_ALLOWED_ORIGINS=

# 留空时容器首次启动会在数据卷里生成 /app/backend/data/.juhe-ai-secret 并复用。
# 迁移已有数据时必须填写原来的 JUHE_AI_SECRET，否则敏感字段无法解密。
JUHE_AI_SECRET=

# 直接用 HTTP 访问时保持 false；HTTPS 反向代理后建议改 true。
JUHE_AI_COOKIE_SECURE=false
JUHE_AI_COOKIE_SAME_SITE=lax
JUHE_AI_TRUST_PROXY=false

# 开发、测试或临时排障可设 true，只关闭登录验证码；密码、限频、会话和权限仍生效。
# 开启时服务会输出 warn，排障结束后恢复 false。
JUHE_AI_AUTH_CAPTCHA_DISABLED=false

# 可选：OpenAI OAuth token 换取 / 刷新的兜底代理。
# 普通上游模型请求仍建议在后台“代理管理”创建代理并绑定到 AI 账户。
# 裸机同机示例：socks5h://127.0.0.1:7890
# Docker Desktop 访问宿主机 sing-box 示例：socks5h://host.docker.internal:7890
JUHE_AI_OAUTH_PROXY_URL=

# 模型检测探针重试。正常探针不做人为并发限制；失败后默认等待一分钟以上再重试。
JUHE_AI_MODEL_CHECK_PROBE_RETRY_DELAY_MS=65000

# 镜像和容器名可按需覆盖。
JUHE_AI_IMAGE=juhe-ai:local
JUHE_AI_CONTAINER_NAME=juhe-ai

# 默认单容器 standalone 模式使用 SQLite + 内存缓存。
# 高性能模式请复制 .env.performance.example，并使用 compose.performance.yml。
JUHE_AI_RUNTIME_MODE=standalone
JUHE_AI_DATABASE_DRIVER=sqlite
JUHE_AI_CACHE_DRIVER=memory
JUHE_AI_RUNTIME_STATE_DRIVER=memory
JUHE_AI_QUEUE_DRIVER=memory

JUHE_AI_AUDIT_LOG_ENABLED=true

# 原始审计保全策略；正文上限为 0 时使用 hash_only。
JUHE_AI_AUDIT_LOG_SUCCESS_HOT_RETENTION_HOURS=1
JUHE_AI_AUDIT_LOG_SUCCESS_SAMPLE_RATE=0.1
JUHE_AI_AUDIT_LOG_SUCCESS_RETENTION_DAYS=3
JUHE_AI_AUDIT_LOG_PROBLEM_RETENTION_DAYS=7
JUHE_AI_AUDIT_LOG_SUCCESS_FULL_BODY_LIMIT_KB=512
JUHE_AI_AUDIT_LOG_PROBLEM_FULL_BODY_LIMIT_KB=2048

# Go `jobs` 承载 F1 运行日志与 F2 表监控；Go `gateway` 承载 F3 原始审计与 F4 操作日志。
# 它与 Node 共享 loopback network namespace；F3 输入密钥必须独立、稳定且在 production 至少 32 位。
JUHE_AI_GO_GATEWAY_IMAGE=juhe-ai-go-gateway:local
JUHE_AI_GO_GATEWAY_CONTAINER_NAME=juhe-ai-go-gateway
JUHE_AI_GO_JOBS_IMAGE=juhe-ai-go-jobs:local
JUHE_AI_GO_JOBS_CONTAINER_NAME=juhe-ai-go-jobs
JUHE_AI_GO_GATEWAY_RUNTIME_IMAGE=
JUHE_AI_GO_JOBS_RUNTIME_IMAGE=
JUHE_AI_GO_IMAGE=
# Go 依赖下载代理；网络受限环境可显式覆盖为可访问的镜像，例如 https://goproxy.cn,direct。
JUHE_AI_GO_PROXY=https://proxy.golang.org,direct

# Go runtime metrics 持久化默认关闭；开启前先用 maintenance 预置 juhe_stats schema。
JUHE_AI_GO_RUNTIME_METRICS_ENABLED=false
JUHE_AI_GO_RUNTIME_METRICS_STORE=
JUHE_AI_GO_RUNTIME_METRICS_DATABASE_PATH=/app/backend/go-runtime-metrics-data/juhe-ai-go-runtime-metrics.sqlite3
JUHE_AI_GO_RUNTIME_METRICS_POSTGRES_URL=
JUHE_AI_GO_RUNTIME_METRICS_INTERVAL=15s
JUHE_AI_GO_RUNTIME_METRICS_RETENTION_DAYS=30
JUHE_AI_GO_RUNTIME_METRICS_SERVICE=juhe-ai
JUHE_AI_GO_RUNTIME_METRICS_ROLE=jobs

JUHE_AI_AUDIT_LOG_INSTANCE_ID=juhe-ai-go-gateway-audit-log
JUHE_AI_AUDIT_LOG_STORE=sqlite
JUHE_AI_AUDIT_LOG_DATABASE_PATH=/app/backend/audit-log-data/juhe-ai-audit-log.sqlite3
JUHE_AI_AUDIT_LOG_BLOB_DIRECTORY=/app/backend/audit-log-data/audit-payload-blobs
JUHE_AI_AUDIT_LOG_HOT_SEARCH_DIRECTORY=/app/backend/audit-log-data/audit-hot-search
JUHE_AI_AUDIT_LOG_BUSINESS_SETTINGS_PATH=/app/backend/data/juhe-ai.sqlite3
JUHE_AI_AUDIT_LOG_INPUT_LISTEN_ADDRESS=127.0.0.1:3303
JUHE_AI_AUDIT_LOG_INPUT_URL=http://127.0.0.1:3303
JUHE_AI_AUDIT_LOG_INPUT_SECRET=

# 必填：Harbor 内网中的 Node runtime 不可变 digest 引用。禁止填写 Docker Hub 或其他外网 Registry。
JUHE_AI_NODE_IMAGE=

# F1 运行日志索引。实例 ID 必须在共享同一数据存储的部署内稳定且唯一；不要使用容器 ID 等随机值。
JUHE_AI_RUNTIME_LOG_INSTANCE_ID=juhe-ai-go-jobs-runtime-log
JUHE_AI_RUNTIME_LOG_STORE=sqlite
JUHE_AI_RUNTIME_LOG_DATABASE_PATH=/app/backend/runtime-log-data/juhe-ai-runtime-log.sqlite3
JUHE_AI_RUNTIME_LOG_ONCE=false

# F2 表存储监控。SQLite 模式只读 Node 数据卷，快照写入独立 volume；performance 模式改为 postgres。
JUHE_AI_TABLE_MONITOR_INSTANCE_ID=juhe-ai-go-jobs-table-monitor
JUHE_AI_TABLE_MONITOR_STORE=sqlite
JUHE_AI_TABLE_MONITOR_DATABASE_PATH=/app/backend/table-monitor-data/juhe-ai-table-monitor.sqlite3
JUHE_AI_TABLE_MONITOR_INTERVAL=1m
JUHE_AI_TABLE_MONITOR_RUN_TIMEOUT=45s
JUHE_AI_TABLE_MONITOR_OWNER_LEASE=5m
JUHE_AI_TABLE_MONITOR_RETENTION_DAYS=30
JUHE_AI_TABLE_MONITOR_MAX_TABLES=256
JUHE_AI_TABLE_MONITOR_MAX_CONCURRENT_SOURCES=512
JUHE_AI_TABLE_MONITOR_RETENTION_BATCH_SIZE=512
JUHE_AI_TABLE_MONITOR_RETENTION_MAX_BATCHES=512
JUHE_AI_TABLE_MONITOR_STARTUP_TIMEOUT_SECONDS=90

# 后端数据、日志和 usage shard 默认都在 Docker volume 内。
# 一般不需要修改这些路径，除非你明确要挂载到自定义目录。
# JUHE_AI_DATABASE_PATH=/app/backend/data/juhe-ai.sqlite3
# JUHE_AI_DATASET_DATABASE_PATH=/app/backend/data/juhe-ai-dataset.sqlite3
# JUHE_AI_USAGE_CATALOG_DATABASE_PATH=/app/backend/data/juhe-ai-usage-catalog.sqlite3
# JUHE_AI_STATS_DATABASE_PATH=/app/backend/data/juhe-ai-stats.sqlite3
# JUHE_AI_CODEX_CONTEXT_STATE_SHARD_ROOT=/app/backend/data/codex-context/state-shards
# F1/F2/F3 分别只写自己的专用 volume；三个 SQLite 路径不得相同，也不得通过 hard link/symlink 指向同一文件。
# JUHE_AI_RUNTIME_LOG_DATABASE_PATH=/app/backend/runtime-log-data/juhe-ai-runtime-log.sqlite3
# JUHE_AI_TABLE_MONITOR_DATABASE_PATH=/app/backend/table-monitor-data/juhe-ai-table-monitor.sqlite3
# JUHE_AI_AUDIT_LOG_DATABASE_PATH=/app/backend/audit-log-data/juhe-ai-audit-log.sqlite3
# JUHE_AI_AUDIT_LOG_BLOB_DIRECTORY=/app/backend/audit-log-data/audit-payload-blobs
# JUHE_AI_AUDIT_LOG_HOT_SEARCH_DIRECTORY=/app/backend/audit-log-data/audit-hot-search
# JUHE_AI_USAGE_SHARD_ROOT=/app/backend/data/usage-shards
# JUHE_AI_LOG_DIR=/app/backend/logs
