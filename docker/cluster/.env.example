# 集群模式部署配置模板（docker/cluster/，与单机模式完全隔离）。
# 复制为 .env 并填真实值；.env 已 gitignore，禁止入库、写入 docs/ 或聊天。
#
# 每个角色只读自己那一节 + 应用侧；不同角色不要求同一份 .env（互相不打扰）：
#   gateway 节点：通用 + gateway 节点 + 应用侧
#   jobs 节点：   通用 + jobs 节点 + 应用侧
#   入口机：      通用 + 入口机（不需要数据库连接与业务密钥）
#
# 集群不需要：POSTGRES_PASSWORD / REDIS_PASSWORD（无本地 PG/Redis 容器）、
# JUHE_AI_DEPLOY_SERVER（发布走镜像仓库）、JUHE_AI_PROXY_IP_A/B（单机隧道域名的
# extra_hosts 专属）。

# ---- 通用 ----
# 节点间共享根（NFS/云 NAS），其下 data/ 与 logs/ 挂给 gateway/jobs。
# 所有节点 UID/GID 必须一致（镜像内固定 app=1000），目录须由 1000:1000 可写。
JUHE_AI_SHARED_ROOT=/srv/juhe-ai

# ---- gateway 节点（compose.gateway.yml） ----
# 镜像完整引用：推荐不可变 digest（build-images.sh 的 build/images.txt 输出）。
JUHE_AI_GATEWAY_IMAGE=registry.example.com/juhe-ai@sha256:<64hex>
# 本节点实例标识：全集群唯一（日志文件名、build_info、租约 owner 依赖）。
# 建议 <region>-<host>-gateway，如 cn-a-gw1。
JUHE_AI_INSTANCE_ID=gw1
# API 监听绑定宿主地址：LB 能访问到的节点内网 IP；0.0.0.0 表示全部。
JUHE_AI_GATEWAY_BIND=0.0.0.0
# 每台 gateway 前面的可信代理层数（1 = 只有一层 LB/Caddy）；直连客户端不要配。
JUHE_AI_TRUST_PROXY=1

# ---- jobs 节点（compose.jobs.yml） ----
JUHE_AI_JOBS_IMAGE=registry.example.com/juhe-ai@sha256:<64hex>
# 集群内唯一；standby 与 leader 必须不同，否则日志文件互相覆盖。
JUHE_AI_JOBS_INSTANCE_ID=jobs1

# ---- 入口机（compose.edge.yml） ----
# 空格分隔的 gateway 地址列表；Caddy 主动健康检查 + least_conn + 失败换台重试。
JUHE_AI_GATEWAY_UPSTREAMS=10.0.0.11:3000 10.0.0.12:3000
# 入口域名（自动 HTTPS 签发）；DNS 必须已指向本入口机。
JUHE_AI_EDGE_DOMAIN=api.example.com
# 前端服务地址（默认同机 frontend:80；前端独立部署时覆盖）。
# JUHE_AI_FRONTEND_UPSTREAM=frontend:80

# ---- 镜像构建与一次性维护（构建机/维护窗需要，日常运行节点可删） ----
JUHE_AI_REGISTRY=registry.example.com/juhe-ai
JUHE_AI_IMAGE_TAG=20261107-r1
# 一次性 schema 初始化/升级用（取自 build/images.txt 的 -maintenance 行）。
JUHE_AI_MAINTENANCE_IMAGE=registry.example.com/juhe-ai@sha256:<64hex>

# ---- 应用侧（gateway/jobs 共用；入口机不需要） ----
JUHE_AI_SECRET=<至少32位稳定随机密钥>
# 外部 PostgreSQL（云 RDS / 独立高可用实例）；连接串含口令，属密钥文件内容。
JUHE_AI_POSTGRES_URL=postgres://juhe_ai:<password>@pg.internal:5432/juhe_ai?sslmode=disable
# 运行日志库与账户健康输入库必须显式配置（不回退主库，保护隔离）。
JUHE_AI_RUNTIME_LOG_POSTGRES_URL=postgres://juhe_ai:<password>@pg.internal:5432/juhe_ai?sslmode=disable
JUHE_AI_ACCOUNT_HEALTH_INPUT_POSTGRES_URL=postgres://juhe_ai:<password>@pg.internal:5432/juhe_ai?sslmode=disable
# 外部 Redis 单节点：redis://:<password>@redis.internal:6379；
# Cluster 模式：redis://:<password>@node1:6379?addr=node2:6379&addr=node3:6379
JUHE_AI_REDIS_URL=redis://:<password>@redis.internal:6379
# single | cluster（缺省 single）
JUHE_AI_REDIS_MODE=single
# 键空间根：所有键为 juhe-ai:{<namespace>:<域>}:...；同集群所有节点必须同值。
JUHE_AI_REDIS_NAMESPACE=prod
JUHE_AI_ALLOWED_ORIGINS=https://api.example.com
# 生产必须 true（HTTPS 入口）
JUHE_AI_COOKIE_SECURE=true
# 审计 payload blob 目录：位于共享 data 挂载内，跨节点可读。
JUHE_AI_AUDIT_LOG_BLOB_DIRECTORY=/app/backend/data/audit-payload-blobs
