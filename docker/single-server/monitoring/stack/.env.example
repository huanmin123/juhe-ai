# 监控栈环境变量（监控机 /opt/juhe-monitoring-stack/.env）
#
# 复制为 .env 后填写；权限 600，不入库。
# 应用机采集栈用另一个 .env（见 ../collector/README.md），两者不要混用。

# Grafana 管理员初始密码（必填；首次登录后建议修改并同步此处）
GRAFANA_ADMIN_PASSWORD=

# Grafana 对外访问地址；同机直接访问可留空用默认 http://127.0.0.1:3000/
GRAFANA_ROOT_URL=

# Grafana 管理员用户名，默认 admin
GRAFANA_ADMIN_USER=admin
