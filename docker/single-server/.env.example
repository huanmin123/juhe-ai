# 国内单机 Docker 部署运行时配置模板。
# 复制为 .env 并填入真实值（.env 已 gitignore，禁止入库或复制到 docs/）。
#
# 两类变量：
# 1) 部署/编排侧：仅供 docker compose 插值与 deploy.sh 读取。
# 2) 应用侧：由 compose env_file 注入 gateway/jobs/maintenance 三进程。
# 密码只维护在 PASSWORD 变量中：PG 进程把 POSTGRES_PASSWORD 映射为
# PGPASSWORD，Redis 工厂用 REDIS_PASSWORD 注入；连接串本身不写密码。
# URL 若显式带密码，则以 URL 为准（密码轮换时注意两处同步）。

# ---- 部署/编排侧 ----
JUHE_AI_DEPLOY_SERVER=<user>@<服务器IP>
POSTGRES_PASSWORD=<PostgreSQL 强密码>
REDIS_PASSWORD=<Redis 强密码>
# 镜像 tag 前缀；留空/不配置时 compose 使用 latest。deploy.sh 会注入本次版本，
# 并在发布验证通过后更新 latest-<role> 别名；手工回滚时显式指定目标版本。
# JUHE_AI_IMAGE_TAG=<版本号>
# 旧出海隧道域名 data./egress.aijh.huanmin.top 的 IP 钉死；compose 以
# :?required 引用，未删除 extra_hosts 前必须填写（不用旧隧道时填服务器 IP 占位）。
JUHE_AI_PROXY_IP_A=<代理A公网IP或服务器IP>
JUHE_AI_PROXY_IP_B=<代理B公网IP或服务器IP>

# ---- 应用侧 ----
JUHE_AI_SECRET=<至少32位稳定随机密钥>
JUHE_AI_POSTGRES_URL=postgres://juhe_ai@postgres:5432/juhe_ai
# 运行日志库与账户健康输入库必须显式配置（不回退主库，保护隔离）：
JUHE_AI_RUNTIME_LOG_POSTGRES_URL=postgres://juhe_ai@postgres:5432/juhe_ai
JUHE_AI_ACCOUNT_HEALTH_INPUT_POSTGRES_URL=postgres://juhe_ai@postgres:5432/juhe_ai
# Redis 单节点：redis://<host>:<port>；Cluster：redis://<host1>:<port>?addr=<host2>:<port>&addr=<host3>:<port>
JUHE_AI_REDIS_URL=redis://redis:6379
# single | cluster（缺省 single）
JUHE_AI_REDIS_MODE=single
# 键空间根：所有键为 juhe-ai:{<namespace>:<域>}:...
JUHE_AI_REDIS_NAMESPACE=prod
JUHE_AI_ALLOWED_ORIGINS=https://<管理端域名>
# 生产必须 true；本地 HTTP 调试可设 false
JUHE_AI_COOKIE_SECURE=true
JUHE_AI_TRUST_PROXY=true
JUHE_AI_AUDIT_LOG_BLOB_DIRECTORY=/app/backend/data/audit-payload-blobs
