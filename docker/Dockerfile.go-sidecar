ARG GO_IMAGE=golang:1.26-bookworm
ARG RUNTIME_IMAGE=debian:bookworm-slim
ARG GO_PROXY=https://proxy.golang.org,direct

FROM ${GO_IMAGE} AS build
ARG GO_PROXY
ENV GOPROXY=${GO_PROXY}
WORKDIR /source/backend-go

COPY backend-go/go.mod backend-go/go.sum ./
RUN go mod download

COPY backend-go ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/juhe-ai-go-sidecar ./cmd/juhe-ai-go-sidecar \
  && printf '%s\n' \
    'package main' \
    'import ("net"; "net/http"; "os"; "time")' \
    'func probe(address, path string) bool {' \
    '  host, port, err := net.SplitHostPort(address)' \
    '  if err != nil { return false }' \
    '  endpoint := "http://" + net.JoinHostPort(host, port) + path' \
    '  response, err := (&http.Client{Timeout: 2 * time.Second}).Get(endpoint)' \
    '  if err != nil { return false }' \
    '  defer response.Body.Close()' \
    '  return response.StatusCode == http.StatusNoContent' \
    '}' \
    'func main() {' \
    '  auditAddress := os.Getenv("JUHE_AI_AUDIT_LOG_INPUT_LISTEN_ADDRESS")' \
    '  if auditAddress == "" { auditAddress = "127.0.0.1:3303" }' \
    '  operationAddress := os.Getenv("JUHE_AI_OPERATION_LOG_INPUT_LISTEN_ADDRESS")' \
    '  if operationAddress == "" { operationAddress = "127.0.0.1:3304" }' \
    '  if !probe(auditAddress, "/__aiinternal__/health") || !probe(operationAddress, "/__aiinternal__/v1/operation-logs/health") { os.Exit(1) }' \
    '}' > /tmp/sidecar-healthcheck.go \
  && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/juhe-ai-go-sidecar-healthcheck /tmp/sidecar-healthcheck.go

FROM ${RUNTIME_IMAGE} AS runtime
WORKDIR /app

COPY --from=build /out/juhe-ai-go-sidecar /usr/local/bin/juhe-ai-go-sidecar
COPY --from=build /out/juhe-ai-go-sidecar-healthcheck /usr/local/bin/juhe-ai-go-sidecar-healthcheck

RUN test -x /usr/local/bin/juhe-ai-go-sidecar \
  && test -x /usr/local/bin/juhe-ai-go-sidecar-healthcheck \
  && mkdir -p /app/backend/data /app/backend/runtime-log-data /app/backend/table-monitor-data /app/backend/audit-log-data /app/backend/operation-log-data /app/backend/logs

ENTRYPOINT ["/usr/local/bin/juhe-ai-go-sidecar"]
