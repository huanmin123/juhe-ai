# juhe-ai 内网生产演练运行时配置模板。
# 复制为 /opt/juhe-ai-dev/.env（600），真实值只放服务器与 .local/project-resources/dev/env/server.env。
#
# 本实例按生产语义运行（真实演练），但不是生产实例（103.36.63.105）：
# - NODE_ENV=production：启用生产安全门禁（强 secret、CORS 白名单、禁用 dev 自动登录）；
# - 验证码开启：JUHE_AI_AUTH_CAPTCHA_DISABLED=false；
# - 首登强制改密门禁开启：JUHE_AI_AUTH_MUST_CHANGE_PASSWORD_GATE_DISABLED=false；
# - 唯一例外是内网 HTTP：JUHE_AI_COOKIE_SECURE=false；配置 HTTPS 后必须改 true；
# - PG/Redis 均不在本 compose 内，连接串指向 pg16 容器与共享 Redis。

# ---- 应用 ----
NODE_ENV=production
TZ=Asia/Shanghai
JUHE_AI_HOST=0.0.0.0
JUHE_AI_PORT=3000
JUHE_AI_FRONTEND_DIST_PATH=/app/frontend/dist
JUHE_AI_DATA_DIR=/app/backend/data
JUHE_AI_LOG_DIR=/app/backend/logs
JUHE_AI_LOG_CONSOLE_ENABLED=true
JUHE_AI_LOG_MAX_FILE_MB=100
JUHE_AI_LOG_MAX_FILES=50
JUHE_AI_LOG_RETENTION_DAYS=7

# health/metrics 只在容器网络暴露；gateway 3306、jobs 3305。
JUHE_AI_GATEWAY_HEALTH_LISTEN_ADDRESS=0.0.0.0:3306
JUHE_AI_GATEWAY_HEALTH_ALLOW_NON_LOOPBACK=true
JUHE_AI_JOBS_HEALTH_LISTEN_ADDRESS=0.0.0.0:3305
JUHE_AI_OWNER_LEASE_ACQUIRE_WAIT=45s

JUHE_AI_SECRET=<至少32位稳定随机密钥>
# pg16 是 infra_default 网络上的容器名；数据库/角色/口令见 .local/project-resources/dev/database/README.md。
JUHE_AI_POSTGRES_URL=postgres://juhe_ai_dev:<DB口令>@pg16:5432/juhe_ai_dev?sslmode=disable
JUHE_AI_RUNTIME_LOG_POSTGRES_URL=postgres://juhe_ai_dev:<DB口令>@pg16:5432/juhe_ai_dev?sslmode=disable
JUHE_AI_ACCOUNT_HEALTH_INPUT_POSTGRES_URL=postgres://juhe_ai_dev:<DB口令>@pg16:5432/juhe_ai_dev?sslmode=disable

# 共享 Redis；密码含 @ 时必须 percent-encode（%40）。namespace 固定 dev。
JUHE_AI_REDIS_URL=redis://:<URL 编码后的 Redis 口令>@<redis-host>:6379
JUHE_AI_REDIS_MODE=single
JUHE_AI_REDIS_NAMESPACE=dev

# 浏览器访问 Origin；只允许内网 Nginx 8193。production 下不得为 * 或空。
JUHE_AI_ALLOWED_ORIGINS=http://<演练服务器IP>:8193,http://127.0.0.1:8193
# 内网 HTTP 是唯一的生产语义例外；配置 HTTPS 后必须改 true。
JUHE_AI_COOKIE_SECURE=false
JUHE_AI_TRUST_PROXY=true
# 生产演练开启验证码；不得用 true 关闭。
JUHE_AI_AUTH_CAPTCHA_DISABLED=false
# 生产演练启用首登强制改密门禁；production 下 true 会拒绝启动。
JUHE_AI_AUTH_MUST_CHANGE_PASSWORD_GATE_DISABLED=false
# 不要配置 JUHE_AI_DEV_AUTO_LOGIN_USERNAME；production 下设置会拒绝启动。

JUHE_AI_AUDIT_LOG_BLOB_DIRECTORY=/app/backend/data/audit-payload-blobs
