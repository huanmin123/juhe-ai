# juhe-ai 生产演练内网入口（Nginx 8193）
#
# 安装：复制为 /etc/nginx/conf.d/juhe-ai-dev.conf，替换 <演练服务器IP> 后
#   nginx -t && nginx -s reload
# 放行：firewall-cmd --permanent --add-rich-rule='rule family="ipv4" source address="<内网段>" port port="8193" protocol="tcp" accept'
#       firewall-cmd --reload
#
# 只承载 juhe-ai 生产演练实例；不复用 aiagent 的 80/443/8192。

server {
    listen 8193;
    server_name _;
    server_tokens off;

    allow 127.0.0.1;
    allow <内网段>;
    deny all;

    location = / {
        return 302 /__aisys__/;
    }

    location / {
        proxy_pass http://127.0.0.1:13000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # 覆盖式写入，客户端不能伪造来源 IP。
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto http;
        # SSE / 长响应：关闭缓冲与缓存，放宽读写超时。
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        # 图像 lane 上限 64 MiB。
        client_max_body_size 64m;
    }
}
