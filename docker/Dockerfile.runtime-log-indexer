# syntax=docker/dockerfile:1

ARG GO_IMAGE=golang:1.26-bookworm
ARG RUNTIME_IMAGE=debian:bookworm-slim
ARG GO_PROXY=https://proxy.golang.org,direct

FROM ${GO_IMAGE} AS build
ARG GO_PROXY
ENV GOPROXY=${GO_PROXY}
WORKDIR /source/backend-go

COPY backend-go/go.mod backend-go/go.sum ./
RUN go mod download

COPY backend-go ./
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/juhe-ai-runtime-log-indexer ./cmd/juhe-ai-runtime-log-indexer

FROM ${RUNTIME_IMAGE} AS runtime
WORKDIR /app

COPY --from=build /out/juhe-ai-runtime-log-indexer /usr/local/bin/juhe-ai-runtime-log-indexer

RUN test -x /usr/local/bin/juhe-ai-runtime-log-indexer \
  && mkdir -p /app/backend/data /app/backend/logs

ENV JUHE_AI_RUNTIME_LOG_ONCE=false

ENTRYPOINT ["/usr/local/bin/juhe-ai-runtime-log-indexer"]
