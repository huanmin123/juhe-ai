{
  "name": "juhe-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "package:release": "pwsh ./scripts/package-release.ps1",
    "package:release:windows": "pwsh ./scripts/package-release.ps1",
    "package:release:mac": "bash ./scripts/package-release.sh",
    "package:release:linux": "bash ./scripts/package-release.sh",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test:smoke": "pnpm --filter juhe-ai-backend test:smoke",
    "test:scope": "pnpm --filter juhe-ai-backend test:scope",
    "test:proxy-negative": "pnpm --filter juhe-ai-backend test:proxy-negative",
    "test:large-response": "pnpm --filter juhe-ai-backend test:large-response",
    "test:stream-first-output-timeout": "pnpm --filter juhe-ai-backend test:stream-first-output-timeout",
    "test:db-service-worker-local": "pnpm --filter juhe-ai-backend test:db-service-worker-local",
    "test:disabled-account-state-guard": "pnpm --filter juhe-ai-backend test:disabled-account-state-guard"
  },
  "engines": {
    "node": ">=22.5.0",
    "pnpm": ">=9.0.0"
  }
}
