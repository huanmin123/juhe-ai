{
  "name": "juhe-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "test:dev-go-project-env": "node scripts/regression/dev-go-project-env-regression.mjs",
    "test:docker-go-project-isolation": "node scripts/regression/docker-go-project-isolation-regression.mjs",
    "test:platform-time-contract": "node scripts/regression/platform-time-contract.test.mjs",
    "test:account-test-task-polling": "pnpm --filter juhe-ai-frontend test:account-test-task-polling",
    "test:runtime-display-contract": "pnpm --filter juhe-ai-frontend test:runtime-display-contract",
    "build": "pnpm -r build",
    "package:release": "pwsh ./scripts/package-release.ps1",
    "package:release:windows": "pwsh ./scripts/package-release.ps1",
    "package:release:mac": "bash ./scripts/package-release.sh",
    "package:release:linux": "bash ./scripts/package-release.sh",
    "test:legacy-node-index-bridge": "node scripts/regression/legacy-node-postgres-index-bridge-contract.test.mjs",
    "test:macos-operations": "pnpm test:legacy-node-index-bridge && pwsh -File ./scripts/regression/validate-macos-operations.ps1",
    "test:release-go-project-launchers": "node scripts/regression/release-go-project-launcher-regression.mjs",
    "test:release-package": "node scripts/validate-release-package.test.mjs && pnpm test:legacy-node-index-bridge",
    "test:redis-role-operations": "pwsh -File ./scripts/regression/validate-redis-role-operations.ps1",
    "test:release-source-preflight": "pwsh -NoProfile -File ./scripts/regression/validate-release-source-preflight.ps1",
    "test:test-rehearsal": "node scripts/validate-test-rehearsal.test.mjs",
    "test:test-rehearsal-evidence-binding": "node scripts/verify-test-rehearsal-evidence.test.mjs",
    "test:jenkins-release-gate": "node scripts/regression/jenkins-release-gate-contract.test.mjs",
    "test:owner-manifest": "node scripts/validate-owner-manifest.test.mjs",
    "test:owner-cutover-matrix": "node scripts/owner-cutover-matrix.test.mjs",
    "test:owner-lock": "node --test scripts/run-with-owner-lock.test.mjs",
    "validate:owner-manifest": "node scripts/validate-owner-manifest.mjs deploy/owner-manifest.json",
    "validate:owner-manifest:node": "node scripts/validate-owner-manifest.mjs --require-all-routes-owner=node --require-node-version=0.1.0 deploy/owner-manifest.json",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test:response-inspection-policy-progressive-loading": "pnpm --filter juhe-ai-frontend test:response-inspection-policy-progressive-loading",
    "test:authorization-usage-progressive-loading": "pnpm --filter juhe-ai-frontend test:authorization-usage-progressive-loading",
    "test:ai-performance-progressive-loading": "pnpm --filter juhe-ai-frontend test:ai-performance-progressive-loading",
    "test:app-brand-singleflight": "pnpm --filter juhe-ai-frontend test:app-brand-singleflight",
    "test:stats-overview-progressive-loading": "pnpm --filter juhe-ai-frontend test:stats-overview-progressive-loading",
    "test:system-metrics-progressive-loading": "pnpm --filter juhe-ai-frontend test:system-metrics-progressive-loading",
    "test:provider-catalog-progressive-loading": "pnpm --filter juhe-ai-frontend test:provider-catalog-progressive-loading",
    "test:settings-sections-progressive-loading": "pnpm --filter juhe-ai-frontend test:settings-sections-progressive-loading",
    "test:announcement-progressive-loading": "pnpm --filter juhe-ai-frontend test:announcement-progressive-loading",
    "test:time-schedule": "pnpm --filter juhe-ai-frontend test:time-schedule",
    "test:xai-account-capability": "pnpm --filter juhe-ai-frontend test:xai-account-capability",
    "test:provider-auth-account-capability": "pnpm --filter juhe-ai-frontend test:provider-auth-account-capability",
    "test:account-list-inline-dynamic": "pnpm --filter juhe-ai-frontend test:account-list-inline-dynamic",
    "test:group-list-inline-dynamic": "pnpm --filter juhe-ai-frontend test:group-list-inline-dynamic",
    "test:w3-auth-system-account-smoke": "pnpm --filter juhe-ai-frontend test:w3-auth-system-account-smoke",
    "test:profile-page": "pnpm --filter juhe-ai-frontend test:profile-page",
    "test:user-request-limit": "pnpm --filter juhe-ai-frontend test:user-request-limit-ui && pnpm --filter juhe-ai-frontend test:profile-page",
    "test:route-strategy-create-api": "pnpm --filter juhe-ai-frontend test:route-strategy-create-api",
    "test:route-strategy-progressive-loading": "pnpm --filter juhe-ai-frontend test:route-strategy-progressive-loading",
    "test:plan0081-real-go-management-smoke": "pnpm --filter juhe-ai-frontend test:plan0081-real-go-management-smoke",
    "smoke:plan0081-real-go-management": "pnpm --filter juhe-ai-frontend smoke:plan0081-real-go-management",
    "test:plan0081-real-go-external-source-create-smoke": "pnpm --filter juhe-ai-frontend test:plan0081-real-go-external-source-create-smoke",
    "smoke:plan0081-real-go-external-source-create": "pnpm --filter juhe-ai-frontend smoke:plan0081-real-go-external-source-create",
    "test:plan0081-real-go-external-source-reset-smoke": "pnpm --filter juhe-ai-frontend test:plan0081-real-go-external-source-reset-smoke",
    "smoke:plan0081-real-go-external-source-reset-confirmation": "pnpm --filter juhe-ai-frontend smoke:plan0081-real-go-external-source-reset-confirmation",
    "smoke:plan0081-real-go-external-source-reset": "pnpm --filter juhe-ai-frontend smoke:plan0081-real-go-external-source-reset",
    "test:plan0081-real-go-settings-write-smoke": "pnpm --filter juhe-ai-frontend test:plan0081-real-go-settings-write-smoke",
    "smoke:plan0081-real-go-settings-write": "pnpm --filter juhe-ai-frontend smoke:plan0081-real-go-settings-write",
    "test:plan0081-real-go-client-ip-allowlist-smoke": "pnpm --filter juhe-ai-frontend test:plan0081-real-go-client-ip-allowlist-smoke",
    "smoke:plan0081-real-go-client-ip-allowlist": "pnpm --filter juhe-ai-frontend smoke:plan0081-real-go-client-ip-allowlist",
    "smoke:plan0081-real-go-client-ip-allowlist-cleanup-only": "pnpm --filter juhe-ai-frontend smoke:plan0081-real-go-client-ip-allowlist-cleanup-only",
    "test:account-proxy-options-lazy-loading": "pnpm --filter juhe-ai-frontend test:account-proxy-options-lazy-loading",
    "test:public-api-log-detail-delta": "pnpm --filter juhe-ai-frontend test:public-api-log-detail-delta",
    "test:public-api-log-page-window": "pnpm --filter juhe-ai-frontend test:public-api-log-page-window",
    "test:operation-log-default-window": "pnpm --filter juhe-ai-frontend test:operation-log-default-window"
  },
  "engines": {
    "node": ">=22.13.0 <23 || >=24.11.0 <25",
    "pnpm": ">=9.0.0"
  },
  "description": "聚合 AI（`juhe-ai`）是一个轻量级 OpenAI 兼容中转、账号调度与 API Key 管理系统。",
  "main": "index.js",
  "directories": {
    "doc": "docs"
  },
  "repository": {
    "type": "git",
    "url": "git@gitee.com:huanminabc/juhe-ai.git"
